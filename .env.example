# Supabase (dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Astro public aliases (same values for SSR + client)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Admin login password (server-side)
ADMIN_PASSWORD=choose-a-strong-password

# Server-only — required for /admin/rsvps guest list (never prefix with PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
