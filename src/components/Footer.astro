---
import QRCode from 'qrcode';
import { REGISTRY_URL } from '../lib/site-urls';

const year = new Date().getFullYear();

const qrTargetUrl =
	typeof import.meta.env.PUBLIC_REGISTRY_QR_URL === 'string' && import.meta.env.PUBLIC_REGISTRY_QR_URL.trim() !== ''
		? import.meta.env.PUBLIC_REGISTRY_QR_URL.trim()
		: REGISTRY_URL;

const qrSvg = await QRCode.toString(qrTargetUrl, {
	type: 'svg',
	errorCorrectionLevel: 'M',
	margin: 1,
	width: 168,
	color: {
		dark: '#2a1a32ff',
		light: '#faf6f0ff',
	},
});
---

