---
import QRCode from 'qrcode';
import { CONTACT_EMAIL, CONTACT_PHONE_JOCELYN, CONTACT_PHONE_RENE, REGISTRY_URL } from '../lib/site-urls';

const year = new Date().getFullYear();

const qrTargetUrl =
	typeof import.meta.env.PUBLIC_REGISTRY_QR_URL === 'string' && import.meta.env.PUBLIC_REGISTRY_QR_URL.trim() !== ''
		? import.meta.env.PUBLIC_REGISTRY_QR_URL.trim()
		: REGISTRY_URL;

const qrSvg = await QRCode.toString(qrTargetUrl, {
	type: 'svg',
	errorCorrectionLevel: 'M',
	margin: 1,
	width: 168,
	color: {
		dark: '#2a1a32ff',
		light: '#faf6f0ff',
	},
});
---

<footer class="border-t border-mauve/20 bg-plum-deep py-14 text-center text-ivory/85" data-reveal>
	<div class="mx-auto max-w-3xl px-6">
		<p class="font-serif text-2xl text-cream md:text-3xl">Jocelyn & René</p>
		<p class="mt-2 text-sm">
			<span data-strand="en">September 12, 2026 · Tesoro Adobe Historic Park</span>
			<span data-strand="es">12 de septiembre de 2026 · Tesoro Adobe Historic Park</span>
		</p>
		<p class="mt-1 text-sm text-ivory/75">29350 Avenida Rancho Tesoro, Valencia, CA 91354</p>

		<!-- <figure class="mx-auto mt-10 max-w-[11rem]">
			<a
				href={qrTargetUrl}
				class="block rounded-2xl border border-ivory/20 bg-cream/95 p-3 shadow-lg shadow-black/10 transition hover:border-cream/40 hover:bg-cream"
				aria-describedby="qr-caption"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="sr-only">
					<span data-strand="en">Open registry on Zola</span>
					<span data-strand="es">Abrir lista de regalos en Zola</span>
				</span>
				<div
					class="[&_svg]:block [&_svg]:h-auto [&_svg]:w-full [&_svg]:max-w-full"
					set:html={qrSvg}
				/>
			</a>
			<figcaption id="qr-caption" class="mt-3 space-y-1 text-center text-xs text-ivory/70">
				<p>
					<span data-strand="en">Scan to open our Zola registry</span>
					<span data-strand="es">Escanea para abrir nuestra lista en Zola</span>
				</p>
				<p class="break-all font-mono text-[10px] leading-snug text-ivory/55">{qrTargetUrl}</p>
			</figcaption>
		</figure> -->

		<div class="footer-contact">
			<p class="footer-contact-intro">
				<span data-strand="en">Any questions?</span>
				<span data-strand="es">¿Alguna pregunta?</span>
			</p>
			<div class="footer-contact-details">
				<div class="footer-contact-phones">
					<ul class="footer-contact-numbers">
						<li>René: {CONTACT_PHONE_RENE}</li>
						<li>Jocelyn: {CONTACT_PHONE_JOCELYN}</li>
					</ul>
				</div>
				<span class="footer-contact-divider" aria-hidden="true">|</span>
				<span class="footer-contact-email-wrap">
					<span data-strand="en">Email us: </span>
					<span data-strand="es">Escríbenos: </span>
					<a class="footer-contact-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
				</span>
			</div>
		</div>
		<p class="mt-6 text-xs text-ivory/50">
			<span data-strand="en">© {year} Jocelyn & Rene. A love story written by God, celebrated with family, and remembered forever.			</span>
			<span data-strand="es">© {year} Jocelyn & Rene. Una historia de amor escrita por Dios, celebrada con familia, y recordada para siempre.</span>
		</p>
	</div>
</footer>

<style>
	.footer-contact {
		margin-top: 2rem;
		font-size: 0.95rem;
		color: rgb(245 240 232 / 0.85);
	}

	.footer-contact-intro {
		margin: 0 0 0.75rem;
		line-height: 1.5;
	}

	.footer-contact-details {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
	}

	.footer-contact-phones {
		text-align: center;
	}

	.footer-contact-numbers {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 0.75rem;
		line-height: 1.45;
	}

	.footer-contact-numbers li + li::before {
		content: '·';
		margin-right: 0.75rem;
		opacity: 0.6;
	}

	.footer-contact-divider {
		opacity: 0.5;
	}

	.footer-contact-email {
		display: inline-block;
		padding: 0.125rem 0.25rem;
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-contact-email:hover {
		opacity: 0.75;
	}

	.footer-contact-email:focus-visible {
		outline: 2px solid rgb(245 240 232 / 0.6);
		outline-offset: 3px;
		border-radius: 2px;
	}

	@media (max-width: 640px) {
		.footer-contact-details {
			flex-direction: column;
			gap: 0.625rem;
		}
	}
</style>
