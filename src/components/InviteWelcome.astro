---
import type { GuestRecord } from '../lib/guests';

type Props = {
	guest: GuestRecord;
};

const { guest } = Astro.props;

const localeDateOpts = { dateStyle: 'medium', timeStyle: 'short' } satisfies Intl.DateTimeFormatOptions;

const rsvpAtEn = guest.rsvp_submitted_at
	? new Intl.DateTimeFormat('en-US', localeDateOpts).format(new Date(guest.rsvp_submitted_at))
	: null;
const rsvpAtEs = guest.rsvp_submitted_at
	? new Intl.DateTimeFormat('es-US', localeDateOpts).format(new Date(guest.rsvp_submitted_at))
	: null;

const hasRsvp = guest.rsvp_status === 'yes' || guest.rsvp_status === 'no';
const attending = guest.rsvp_status === 'yes';
---

<section
	class="relative overflow-hidden border-b border-mauve/15 bg-gradient-to-b from-ivory to-cream py-10 text-plum-deep md:py-12"
	data-reveal
>
	<div
		class="pointer-events-none absolute -left-16 top-0 h-48 w-48 rounded-full bg-mauve/10 blur-3xl"
		aria-hidden="true"
	></div>
	<div class="relative mx-auto max-w-3xl px-6 text-center md:px-8">
		<p class="text-xs font-medium uppercase tracking-[0.32em] text-brown-soft">
			<span data-strand="en">A personal invitation for</span>
			<span data-strand="es">Una invitación personal para</span>
		</p>
		<h1 class="mt-3 font-script text-4xl text-plum md:text-5xl">{guest.guest_name}</h1>
		<p class="mt-4 font-serif text-lg text-plum-deep/90 md:text-xl">
			<span data-strand="en">
				We would be honored to celebrate with you on <strong>September 12, 2026</strong> at Tesoro Adobe
				Historic Park.
			</span>
			<span data-strand="es">
				Nos encantaría celebrar contigo el <strong>12 de septiembre de 2026</strong> en Tesoro Adobe Historic
				Park.
			</span>
		</p>
		{
			hasRsvp ? (
				<p
					class="mx-auto mt-6 max-w-lg rounded-2xl border border-mauve/20 bg-white/60 px-5 py-4 text-sm text-brown-soft"
					data-strand="en"
				>
					We have your RSVP on file ({attending ? 'attending' : 'not attending'}), submitted {rsvpAtEn ?? ''}.
					You may update it below anytime.
				</p>
			) : null
		}
		{
			hasRsvp ? (
				<p
					class="mx-auto mt-6 max-w-lg rounded-2xl border border-mauve/20 bg-white/60 px-5 py-4 text-sm text-brown-soft"
					data-strand="es"
				>
					Tenemos tu RSVP registrado ({attending ? 'asistencia confirmada' : 'no podrá asistir'}); enviado el{' '}
					{rsvpAtEs ?? ''}. Puedes actualizarlo abajo cuando quieras.
				</p>
			) : null
		}
		<a
			href="#rsvp"
			class="mt-8 inline-flex min-w-[11rem] justify-center rounded-full bg-plum px-8 py-3 font-medium text-cream transition hover:bg-mauve-dark"
		>
			<span data-strand="en">RSVP</span>
			<span data-strand="es">Confirmar</span>
		</a>
	</div>
</section>
