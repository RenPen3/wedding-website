---
const desktopBgImage = '/hero.jpg';
const mobileBgImage = '/hero_img2.jpg';
---

<section
	class="relative flex min-h-[100svh] flex-col bg-plum-deep"
	aria-labelledby="hero-heading"
>
	<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
		<div
			class="absolute inset-0 hidden bg-cover bg-center md:block"
			style={`background-image: url('${desktopBgImage}'); transform: scaleX(-1) scale(1.08); transform-origin: center center;`}
		>
		</div>
		<div
			class="absolute inset-0 origin-center -scale-x-100 scale-[1.08] bg-cover bg-center md:hidden"
			style={`background-image: url('${mobileBgImage}');`}
		>
		</div>
		<div class="absolute inset-0 bg-gradient-to-b from-plum-deep/70 via-plum-deep/45 to-plum-deep/90"></div>
	</div>

	<div
		class="relative z-10 mx-auto flex w-full max-w-4xl flex-1 flex-col items-center justify-center px-6 pb-16 pt-[var(--site-nav-height,6.5rem)] text-center md:pb-24"
		data-reveal-hero
	>
		<p class="mb-4 text-sm uppercase tracking-[0.35em] text-ivory/90" data-reveal-child style="--reveal-delay: 0ms">
			<span data-strand="en">Together with their families</span>
			<span data-strand="es">Junto a sus familias</span>
		</p>
		<h1
			id="hero-heading"
			class="mx-auto max-w-[min(100%,22rem)] py-1 font-script text-[3.25rem] leading-[1.55] text-cream sm:max-w-[26rem] sm:py-2 sm:text-[3.75rem] sm:leading-[1.5] md:max-w-[30rem] md:text-[4.25rem] md:leading-[1.45] lg:text-[4.75rem]"
			data-reveal-child
			style="--reveal-delay: 100ms"
		>
			Jocelyn <span class="couple-amp">&</span> René
		</h1>
		<p class="mt-8 font-serif text-2xl text-ivory/95 md:text-3xl" data-reveal-child style="--reveal-delay: 200ms">
			<span data-strand="en">September 12, 2026</span>
			<span data-strand="es">12 de septiembre de 2026</span>
		</p>
		<p class="mt-2 text-lg text-ivory/85 md:text-xl" data-reveal-child style="--reveal-delay: 280ms">
			Tesoro Adobe Historic Park
		</p>
		<p class="mt-1 text-base text-ivory/80 md:text-lg" data-reveal-child style="--reveal-delay: 340ms">
			29350 Avenida Rancho Tesoro, Valencia, CA 91354
		</p>
		<div
			class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
			data-reveal-child
			style="--reveal-delay: 420ms"
		>
			<a
				href="/rsvp"
				class="inline-flex min-w-[10rem] items-center justify-center rounded-full border border-cream/40 bg-cream px-8 py-3 font-medium text-plum-deep shadow-lg transition hover:bg-ivory"
			>
				RSVP
			</a>
			<a
				href="#details"
				class="inline-flex min-w-[10rem] items-center justify-center rounded-full border border-ivory/50 px-8 py-3 font-medium text-cream transition hover:border-cream hover:bg-white/10"
			>
				<span data-strand="en">Wedding details</span>
				<span data-strand="es">Detalles de la boda</span>
			</a>
		</div>
	</div>
</section>
