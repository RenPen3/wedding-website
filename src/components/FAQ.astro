---
const faqs = [
	{
		q: 'Can I bring a plus-one?',
		a: 'Your invitation will note the number of seats reserved for your party. If you need a change, please reach out before you RSVP.',
	},
	{
		q: 'Will the ceremony be outdoors?',
		a: 'Yes — September in the Santa Clarita Valley is usually warm and pleasant. In case of rain, we will move the ceremony under the park’s covered backup space.',
	},
	{
		q: 'Are children welcome?',
		a: 'We love your little ones, but this evening will be adults-only so everyone can relax and celebrate.',
	},
	{
		q: 'What about parking?',
		a: 'Free on-site parking is available at the historic park with attendants directing guests. Please follow signage to the designated lot.',
	},
];
---

<section id="faq" class="scroll-mt-24 bg-ivory py-20 md:py-28">
	<div class="mx-auto max-w-3xl px-6 md:px-8">
		<h2 class="text-center font-serif text-3xl text-plum md:text-4xl">Questions</h2>
		<div class="mx-auto mt-4 h-px w-24 bg-mauve/60" aria-hidden="true"></div>
		<dl class="mt-12 space-y-8">
			{
				faqs.map((item) => (
					<div class="rounded-2xl border border-mauve/15 bg-cream/80 p-6">
						<dt class="font-serif text-xl text-plum">{item.q}</dt>
						<dd class="mt-3 leading-relaxed text-brown-soft">{item.a}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
