---
const faqs = [
	{
		q: {
			en: 'When should I RSVP?',
			es: '¿Cuándo debo confirmar mi asistencia?',
		},
		a: {
			en: 'Please respond by August 1st. If we do not receive a response by this date, we will assume you are unable to attend.',
			es: 'Por favor responde antes del 1 de agosto. Si no recibimos tu respuesta para esa fecha, asumiremos que no podrás asistir.',
		},
	},
	{
		q: {
			en: 'Are children welcome?',
			es: '¿Están bienvenidos los niños?',
		},
		a: {
			en: 'We love your little ones, but this evening will be adults-only so everyone can relax and celebrate.',
			es: 'Adoramos a los pequenyos, pero esta fiesta será solo para adultos para que todos puedan celebrar tranquilos.',
		},
	},
	{
		q: {
			en: 'Can I bring a plus-one?',
			es: '¿Puedo traer un acompañante?',
		},
		a: {
			en: 'Your invitation will note the number of seats reserved for your party. If you need a change, please reach out before you RSVP.',
			es: 'Tu invitación indicará cuántos lugares están reservados para tu grupo. Si necesitas algún cambio, escríbenos antes de confirmar.',
		},
	},
	{
		q: {
			en: 'Will the ceremony be outdoors?',
			es: '¿La ceremonia será al aire libre?',
		},
		a: {
			en: 'Yes, September in the Santa Clarita Valley is usually warm and pleasant.',
			es: 'Sí, Septiembre en el valle suele ser cálido y agradable.',
		},
	},
	{
		q: {
			en: 'What about parking?',
			es: '¿Y el estacionamiento?',
		},
		a: {
			en: 'Free on-site parking is available at the historic park.',
			es: 'Hay estacionamiento gratuito en el parque.',
		},
	},
	{
		q: {
			en: 'Can we take photos during the ceremony?',
			es: '¿Podemos tomar fotos durante la ceremonia?',
		},
		a: {
			en: 'We kindly ask guests to be fully present during the ceremony. Photos are welcome during the reception.',
			es: 'Pedimos amablemente que los invitados estén completamente presentes durante la ceremonia. Las fotos son bienvenidas durante la recepción.',
		},
	},
	{
		q: {
			en: 'What time should guests arrive?',
			es: '¿A qué hora deben llegar los invitados?',
		},
		a: {
			en: 'Please arrive 20–30 minutes before the ceremony so everyone can be seated on time.',
			es: 'Por favor lleguen de 20 a 30 minutos antes de la ceremonia para que todos puedan estar sentados a tiempo.',
		},
	},
	{
		q: {
			en: 'Will the ceremony and reception be at the same location?',
			es: '¿La ceremonia y la recepción serán en el mismo lugar?',
		},
		a: {
			en: 'Yes, both will take place at the same venue.',
			es: 'Sí, ambas tendrán lugar en el mismo lugar.',
		},
	},
	{
		q: {
			en: 'What time does the wedding end?',
			es: '¿A qué hora termina la boda?',
		},
		a: {
			en: 'The celebration will end at 10:00 PM.',
			es: 'La celebración terminará a las 10:00 p. m.',
		},
	},
	{
		q: {
			en: 'What is the dress code?',
			es: '¿Cuál es el código de vestimenta?',
		},
		a: {
			en: 'Garden formal attire. Think elegant, romantic, and comfortable for an outdoor celebration.',
			es: 'Vestimenta formal de jardín. Piensa en algo elegante, romántico y cómodo para una celebración al aire libre.',
		},
	},
	{
		q: {
			en: 'What should I avoid wearing?',
			es: '¿Qué debo evitar usar?',
		},
		a: {
			en: 'Please avoid jeans, casual sneakers, and white or ivory outfits.',
			es: 'Por favor evita jeans, tenis casuales y outfits blancos o marfil.',
		},
	},
];

type Props = {
	homeStyle?: boolean;
};

const { homeStyle = false } = Astro.props;
---

<section
	id="faq"
	class:list={[
		'scroll-mt-24 py-20 md:py-28',
		homeStyle ?
			'relative overflow-hidden bg-gradient-to-t from-plum-deep/12 via-cream to-ivory'
		:	'bg-ivory',
	]}
	data-reveal
>
	{
		homeStyle && (
			<div
				class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-plum-deep/8 to-transparent"
				aria-hidden="true"
			/>
		)
	}
	<div class="relative mx-auto max-w-3xl px-6 md:px-8">
		<h2 class="text-center font-serif text-3xl text-plum md:text-4xl">
			<span data-strand="en">Questions</span>
			<span data-strand="es">Preguntas</span>
		</h2>
		<div class="mx-auto mt-4 h-px w-24 bg-mauve/60" aria-hidden="true"></div>
		<dl class="mt-12 space-y-6" data-reveal-stagger>
			{
				faqs.map((item) => (
					<div
						class:list={[
							'rounded-2xl border p-6',
							homeStyle ?
								'border-l-4 border-l-olive border-mauve/15 bg-white/85 shadow-sm'
							:	'border-mauve/15 bg-cream/80',
						]}
					>
						<dt class="font-serif text-xl text-plum">
							<span data-strand="en">{item.q.en}</span>
							<span data-strand="es">{item.q.es}</span>
						</dt>
						<dd class="mt-3 leading-relaxed text-brown-soft">
							<span data-strand="en">{item.a.en}</span>
							<span data-strand="es">{item.a.es}</span>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
