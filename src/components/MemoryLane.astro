---
import {
	memoryLaneHeading,
	memoryLaneHero,
	memoryLaneItems,
	storyTimelineHeading,
} from '../lib/memory-lane';
import { storyIntro } from '../lib/our-story';
---

<section class="memory-lane" aria-labelledby="memory-lane-heading">
	<div class="memory-lane__hero relative flex min-h-[52svh] items-center md:min-h-[58vh]">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div
				class="absolute inset-0 hidden bg-cover bg-center md:block"
				style={`background-image: url('${memoryLaneHero.desktopImage}');`}
			>
			</div>
			<div
				class="absolute inset-0 bg-cover bg-center md:hidden"
				style={`background-image: url('${memoryLaneHero.mobileImage}');`}
			>
			</div>
			<div
				class="absolute inset-0 bg-gradient-to-b from-plum-deep/75 via-plum-deep/50 to-plum-deep/82"
			>
			</div>
		</div>

		<div
			class="relative z-10 mx-auto w-full max-w-3xl px-6 py-20 text-center md:px-8 md:py-24"
			data-reveal-hero
		>
			<p
				class="text-xs font-medium uppercase tracking-[0.32em] text-ivory/85"
				data-reveal-child
				style="--reveal-delay: 0ms"
			>
				<span data-strand="en">Our Story</span>
				<span data-strand="es">Nuestra historia</span>
			</p>
			<h1
				id="memory-lane-heading"
				class="mt-3 font-script text-5xl text-cream md:text-6xl lg:text-7xl"
				data-reveal-child
				style="--reveal-delay: 100ms"
			>
				<span data-strand="en">{memoryLaneHeading.en}</span>
				<span data-strand="es">{memoryLaneHeading.es}</span>
			</h1>
			<div
				class="mx-auto mt-5 h-px w-20 bg-ivory/45"
				aria-hidden="true"
				data-reveal-child
				style="--reveal-delay: 180ms"
			>
			</div>
			<p
				class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-ivory/90 md:text-xl"
				data-reveal-child
				style="--reveal-delay: 260ms"
			>
				<span data-strand="en">{storyIntro.en}</span>
				<span data-strand="es">{storyIntro.es}</span>
			</p>
		</div>
	</div>

	<div class="memory-lane__body bg-cream py-16 md:py-24">
		<div class="mx-auto max-w-6xl px-6 md:px-8">
			<h2
				id="story-timeline-heading"
				class="text-center font-serif text-4xl font-semibold text-plum md:text-5xl"
				data-reveal
			>
				<span data-strand="en">{storyTimelineHeading.en}</span>
				<span data-strand="es">{storyTimelineHeading.es}</span>
			</h2>

			<ol
				class="memory-lane__timeline relative mt-14 list-none p-0 md:mt-20"
				aria-labelledby="story-timeline-heading"
			>
				<div class="memory-lane__line" aria-hidden="true"></div>

				{
					memoryLaneItems.map((item, index) => {
						const textOnLeft = index % 2 === 0;

						return (
							<li
								class:list={[
									'memory-lane__item',
									textOnLeft
										? 'memory-lane__item--text-left'
										: 'memory-lane__item--text-right',
								]}
								data-reveal
								style={`--reveal-delay: ${index * 90}ms`}
							>
								<article class="memory-lane__entry">
									<div class="memory-lane__col memory-lane__col--left">
										{
											textOnLeft ? (
												<div class="memory-lane__copy">
													<p class="memory-lane__date">
														<span data-strand="en">{item.date.en}</span>
														<span data-strand="es">{item.date.es}</span>
													</p>
													<h3 class="memory-lane__title">
														<span data-strand="en">{item.title.en}</span>
														<span data-strand="es">{item.title.es}</span>
													</h3>
													<p class="memory-lane__description">
														<span data-strand="en">{item.description.en}</span>
														<span data-strand="es">{item.description.es}</span>
													</p>
												</div>
											) : (
												<figure class="memory-lane__media">
													<img
														src={item.image}
														alt={item.title.en}
														width="560"
														height="240"
														loading="lazy"
														decoding="async"
														class="memory-lane__photo"
													/>
												</figure>
											)
										}
									</div>

									<div class="memory-lane__col memory-lane__col--center">
										<div class="memory-lane__marker" aria-hidden="true"></div>
									</div>

									<div class="memory-lane__col memory-lane__col--right">
										{
											textOnLeft ? (
												<figure class="memory-lane__media">
													<img
														src={item.image}
														alt={item.title.en}
														width="560"
														height="240"
														loading="lazy"
														decoding="async"
														class="memory-lane__photo"
													/>
												</figure>
											) : (
												<div class="memory-lane__copy">
													<p class="memory-lane__date">
														<span data-strand="en">{item.date.en}</span>
														<span data-strand="es">{item.date.es}</span>
													</p>
													<h3 class="memory-lane__title">
														<span data-strand="en">{item.title.en}</span>
														<span data-strand="es">{item.title.es}</span>
													</h3>
													<p class="memory-lane__description">
														<span data-strand="en">{item.description.en}</span>
														<span data-strand="es">{item.description.es}</span>
													</p>
												</div>
											)
										}
									</div>
								</article>
							</li>
						);
					})
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.memory-lane__timeline {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding-left: 2rem;
	}

	.memory-lane__line {
		position: absolute;
		left: 0.5rem;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--color-brown-muted);
		opacity: 0.65;
	}

	.memory-lane__item {
		position: relative;
		padding-bottom: 3.5rem;
	}

	.memory-lane__item:last-child {
		padding-bottom: 0;
	}

	.memory-lane__entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
	}

	.memory-lane__item--text-right .memory-lane__col--left {
		order: 2;
	}

	.memory-lane__item--text-right .memory-lane__col--right {
		order: 1;
	}

	.memory-lane__col--center {
		position: absolute;
		left: 0.5rem;
		top: 0.35rem;
		width: 1.25rem;
		transform: translateX(-50%);
	}

	.memory-lane__marker {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 9999px;
		border: 2px solid var(--color-brown-muted);
		background: var(--color-cream);
	}

	.memory-lane__marker::after {
		content: '';
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 9999px;
		background: var(--color-brown-muted);
	}

	.memory-lane__copy {
		margin: 0;
		max-width: 100%;
	}

	.memory-lane__date {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--color-brown-muted);
	}

	.memory-lane__title {
		margin: 0.625rem 0 0;
		font-family: var(--font-serif);
		font-size: 1.625rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-plum);
	}

	.memory-lane__description {
		margin: 0.75rem 0 0;
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--color-plum);
	}

	.memory-lane__media {
		margin: 0;
		overflow: hidden;
		border-radius: 1rem;
		box-shadow: 0 6px 28px rgb(61 38 69 / 0.08);
	}

	.memory-lane__photo {
		display: block;
		width: 100%;
		height: clamp(11rem, 42vw, 14rem);
		object-fit: cover;
	}

	.memory-lane__item--text-left .memory-lane__copy {
		text-align: center;
	}

	.memory-lane__item--text-right .memory-lane__copy {
		text-align: left;
	}

	@media (min-width: 768px) {
		.memory-lane__timeline {
			padding-left: 0;
		}

		.memory-lane__line {
			left: 50%;
			transform: translateX(-50%);
		}

		.memory-lane__item {
			padding-bottom: 5.5rem;
		}

		.memory-lane__entry {
			grid-template-columns: minmax(0, 1fr) 80px minmax(0, 1fr);
			align-items: center;
			column-gap: 0;
		}

		.memory-lane__item--text-right .memory-lane__col--left,
		.memory-lane__item--text-right .memory-lane__col--right {
			order: unset;
		}

		.memory-lane__col--center {
			position: relative;
			left: auto;
			top: auto;
			transform: none;
			display: flex;
			justify-content: center;
			align-self: center;
		}

		.memory-lane__col--left,
		.memory-lane__col--right {
			min-width: 0;
		}

		.memory-lane__item--text-left .memory-lane__col--left {
			padding-right: 2rem;
		}

		.memory-lane__item--text-left .memory-lane__col--right {
			padding-left: 2rem;
		}

		.memory-lane__item--text-right .memory-lane__col--left {
			padding-right: 2rem;
			display: flex;
			justify-content: flex-end;
		}

		.memory-lane__item--text-right .memory-lane__col--right {
			padding-left: 2rem;
		}

		.memory-lane__item--text-left .memory-lane__copy {
			margin-left: auto;
			max-width: 22rem;
			text-align: center;
		}

		.memory-lane__item--text-right .memory-lane__copy {
			max-width: 22rem;
			text-align: left;
		}

		.memory-lane__media {
			width: min(100%, 560px);
		}

		.memory-lane__item--text-left .memory-lane__col--right .memory-lane__media {
			margin-right: auto;
		}

		.memory-lane__item--text-right .memory-lane__col--left .memory-lane__media {
			margin-left: auto;
		}

		.memory-lane__photo {
			width: min(100%, 560px);
			height: clamp(12.5rem, 18vw, 16.25rem);
		}

		.memory-lane__title {
			font-size: 1.875rem;
		}
	}

	@media (min-width: 1024px) {
		.memory-lane__item {
			padding-bottom: 6.5rem;
		}

		.memory-lane__item--text-left .memory-lane__col--left {
			padding-right: 2.5rem;
		}

		.memory-lane__item--text-left .memory-lane__col--right {
			padding-left: 2.5rem;
		}

		.memory-lane__item--text-right .memory-lane__col--left {
			padding-right: 2.5rem;
		}

		.memory-lane__item--text-right .memory-lane__col--right {
			padding-left: 2.5rem;
		}

		.memory-lane__photo {
			width: 560px;
			max-width: 100%;
			height: 240px;
		}
	}
</style>
