---
type Props = {
	inviteCode?: string;
	showHeader?: boolean;
};

const { inviteCode = '', showHeader = true } = Astro.props;
---

<div class="relative overflow-visible rounded-3xl border border-mauve/20 bg-cream/92 p-8 shadow-lg backdrop-blur-sm md:p-10">
	{
		showHeader && (
			<>
				<h3 class="font-serif text-2xl text-plum md:text-3xl">RSVP</h3>
				<p class="mt-2 text-brown-soft">
					<span data-strand="en">Please respond by August 1, 2026.</span>
					<span data-strand="es">Por favor responde antes del 1 de agosto de 2026.</span>
				</p>
			</>
		)
	}

	<div id="rsvp-success" class:list={['space-y-6', showHeader ? 'mt-8' : '', 'hidden']} aria-live="polite">
		<p class="font-serif text-2xl text-plum md:text-3xl" id="rsvp-success-heading"></p>
		<div id="rsvp-success-names" class="space-y-3 rounded-2xl border border-mauve/15 bg-white/60 px-5 py-4"></div>
		<p id="rsvp-success-message" class="text-brown-soft leading-relaxed"></p>
	</div>

	<form id="rsvp-form" class:list={['space-y-6', showHeader ? 'mt-8' : '']} autocomplete="off">
		<input type="hidden" id="rsvp-guest-id" name="guestId" value="" />
		<input type="hidden" id="rsvp-invite-code" name="inviteCode" value={inviteCode} />
		<input type="hidden" id="rsvp-guest-name" name="name" value="" autocomplete="off" />

		<div
			id="rsvp-invite-banner"
			class="hidden rounded-2xl border border-mauve/15 bg-white/60 px-5 py-4 text-center"
			aria-live="polite"
		>
			<p id="rsvp-invite-banner-label" class="text-xs font-medium uppercase tracking-wide text-brown-muted"></p>
			<p id="rsvp-invite-banner-name" class="mt-1 font-serif text-2xl text-plum md:text-3xl"></p>
			<p id="rsvp-invite-banner-seats" class="mt-2 text-sm text-brown-soft"></p>
		</div>

		<div class="relative z-10" id="rsvp-name-search-wrap">
			<label for="rsvp-name-search" class="block text-sm font-medium text-plum">
				<span data-strand="en">Find your name</span>
				<span data-strand="es">Busca tu nombre</span>
			</label>
			<input
				type="search"
				id="rsvp-name-search"
				autocomplete="off"
				autocorrect="off"
				spellcheck="false"
				class="mt-2 w-full rounded-xl border border-mauve/25 bg-white px-4 py-3 text-plum-deep outline-none ring-olive/40 focus:ring-2"
				placeholder="Start typing your name…"
				data-ph-en="Start typing your name…"
				data-ph-es="Empieza a escribir tu nombre…"
				role="combobox"
				aria-autocomplete="list"
				aria-expanded="false"
				aria-controls="rsvp-name-dropdown"
			/>
			<ul
				id="rsvp-name-dropdown"
				class="rsvp-dropdown hidden"
				role="listbox"
				aria-label="Matching guests"
			></ul>
			<p id="rsvp-name-status" class="mt-2 hidden text-sm" role="status"></p>
		</div>

		<div id="rsvp-selected-guest" class="hidden grid gap-4 sm:grid-cols-2">
			<div>
				<label for="rsvp-first-name" class="block text-sm font-medium text-plum">
					<span data-strand="en">First name</span>
					<span data-strand="es">Nombre</span>
				</label>
				<input
					type="text"
					id="rsvp-first-name"
					readonly
					tabindex="-1"
					class="mt-2 w-full rounded-xl border border-mauve/20 bg-ivory/80 px-4 py-3 text-plum-deep"
				/>
			</div>
			<div>
				<label for="rsvp-last-name" class="block text-sm font-medium text-plum">
					<span data-strand="en">Last name</span>
					<span data-strand="es">Apellido</span>
				</label>
				<input
					type="text"
					id="rsvp-last-name"
					readonly
					tabindex="-1"
					class="mt-2 w-full rounded-xl border border-mauve/20 bg-ivory/80 px-4 py-3 text-plum-deep"
				/>
			</div>
		</div>

		<div id="rsvp-form-body" class="hidden space-y-6">
			<fieldset>
				<legend class="text-sm font-medium text-plum">
					<span data-strand="en">Will you be attending?</span>
					<span data-strand="es">¿Podrás asistir?</span>
				</legend>
				<div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-6">
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input type="radio" name="attending" value="yes" class="accent-olive" checked />
						<span class="text-brown-soft">
							<span data-strand="en">Joyfully accepts</span>
							<span data-strand="es">Con alegría acepto</span>
						</span>
					</label>
					<label class="inline-flex cursor-pointer items-center gap-2">
						<input type="radio" name="attending" value="no" class="accent-olive" />
						<span class="text-brown-soft">
							<span data-strand="en">Regretfully declines</span>
							<span data-strand="es">Lamentablemente declino</span>
						</span>
					</label>
				</div>
			</fieldset>

			<div id="rsvp-attending-fields" class="space-y-6">
				<div id="rsvp-party-wrap">
					<label class="block text-sm font-medium text-plum">
						<span data-strand="en">Guests attending</span>
						<span data-strand="es">Invitados que asisten</span>
					</label>
					<p id="rsvp-party-hint" class="mt-1 text-sm text-brown-muted"></p>
					<div class="mt-3 flex items-center gap-3">
						<button
							type="button"
							id="rsvp-count-decrease"
							class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-mauve/25 bg-white text-lg text-plum transition hover:border-plum disabled:cursor-not-allowed disabled:opacity-40"
							aria-label="Decrease guest count"
						>
							−
						</button>
						<input
							type="text"
							id="rsvp-count-display"
							readonly
							tabindex="-1"
							aria-live="polite"
							class="w-14 rounded-xl border border-mauve/25 bg-white px-2 py-3 text-center text-plum-deep"
						/>
						<button
							type="button"
							id="rsvp-count-increase"
							class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-mauve/25 bg-white text-lg text-plum transition hover:border-plum disabled:cursor-not-allowed disabled:opacity-40"
							aria-label="Increase guest count"
						>
							+
						</button>
						<input type="hidden" id="rsvp-count" name="guestCount" value="1" />
					</div>
				</div>

				<div>
					<label class="block text-sm font-medium text-plum">
						<span data-strand="en">Guest names</span>
						<span data-strand="es">Nombres de invitados</span>
					</label>
					<p class="mt-1 text-sm text-brown-muted">
						<span data-strand="en">Include everyone who will attend, including yourself.</span>
						<span data-strand="es">Incluye a todas las personas que asistirán, incluido/a tú mismo/a.</span>
					</p>
					<div id="rsvp-guest-names-fields" class="mt-3 space-y-3"></div>
				</div>
			</div>

			<div>
				<label for="rsvp-message" class="block text-sm font-medium text-plum">
					<span data-strand="en">Message for the bride and groom (optional)</span>
					<span data-strand="es">Mensaje para los novios (opcional)</span>
				</label>
				<textarea
					id="rsvp-message"
					name="message"
					rows="3"
					autocomplete="off"
					autocorrect="off"
					spellcheck="false"
					class="mt-2 w-full rounded-xl border border-mauve/25 bg-white px-4 py-3 text-plum-deep outline-none ring-olive/40 focus:ring-2"
					data-ph-en="Share a note with us…"
					data-ph-es="Comparte una nota con nosotros…"
				></textarea>
			</div>

			<p id="rsvp-status" class="hidden text-sm" role="status"></p>
			<button
				type="submit"
				class="w-full rounded-full bg-plum px-6 py-3.5 font-medium text-cream transition hover:bg-mauve-dark md:w-auto"
			>
				<span data-strand="en">Submit RSVP</span>
				<span data-strand="es">Enviar RSVP</span>
			</button>
		</div>
	</form>
</div>

<script>
	type Lang = 'en' | 'es';

	type LookupRsvp = {
		attending: boolean;
		guestCount: number;
		guestNames: string[];
	};

	type GuestMatch = {
		id: string;
		name: string;
		first_name: string;
		last_name: string;
		full_name: string;
		invite_code: string;
		maxGuests: number;
	};

	let selectedGuest: GuestMatch | null = null;
	let fromInviteLink = false;
	let currentMax = 1;
	let currentCount = 1;
	let uiReady = false;
	let searchTimer: ReturnType<typeof setTimeout> | undefined;
	let activeSearchQuery = '';

	type SubmittedRsvp = {
		name: string;
		attending: boolean;
		guestNames: string[];
	};

	let submittedRsvp: SubmittedRsvp | null = null;

	function isEs(): boolean {
		return document.documentElement.classList.contains('lang-es');
	}

	function lang(): Lang {
		return isEs() ? 'es' : 'en';
	}

	function pick<T extends Record<Lang, string>>(t: T) {
		return t[lang()];
	}

	function reservedSeatsMessage(seats: number) {
		return seats === 1 ?
				pick({
					en: 'Your invitation reserves 1 seat.',
					es: 'Tu invitación reserva 1 asiento.',
				})
			:	pick({
					en: `Your invitation reserves ${seats} seats.`,
					es: `Tu invitación reserva ${seats} asientos.`,
				});
	}

	function welcomeMessage(name: string, seats: number) {
		return pick({
			en: `Welcome, ${name}! ${reservedSeatsMessage(seats)}`,
			es: `¡Bienvenido/a, ${name}! ${reservedSeatsMessage(seats)}`,
		});
	}

	function clampCount(value: number, maxGuests: number) {
		return Math.min(maxGuests, Math.max(1, value));
	}

	function isAttending() {
		return (
			document.querySelector<HTMLInputElement>('input[name="attending"][value="yes"]')?.checked ??
			true
		);
	}

	function renderGuestNameFields(count: number, names: string[] = []) {
		const container = document.getElementById('rsvp-guest-names-fields');
		if (!container) return;

		container.innerHTML = '';

		for (let i = 0; i < count; i++) {
			const label = document.createElement('label');
			label.className = 'block';
			label.htmlFor = `rsvp-guest-name-${i}`;

			const labelText = document.createElement('span');
			labelText.className = 'text-xs font-medium text-brown-muted';
			labelText.textContent = pick({
				en: `Guest ${i + 1}`,
				es: `Invitado ${i + 1}`,
			});

			const input = document.createElement('input');
			input.type = 'text';
			input.id = `rsvp-guest-name-${i}`;
			input.name = `rsvp-attending-guest-${i}`;
			input.required = true;
			input.autocomplete = 'off';
			input.setAttribute('autocorrect', 'off');
			input.setAttribute('spellcheck', 'false');
			input.setAttribute('data-1p-ignore', 'true');
			input.setAttribute('data-lpignore', 'true');
			input.className =
				'mt-1 w-full rounded-xl border border-mauve/25 bg-white px-4 py-3 text-plum-deep outline-none ring-olive/40 focus:ring-2';
			input.value = names[i]?.trim() ?? '';
			input.placeholder = pick({
				en: `Guest ${i + 1} full name`,
				es: `Invitado ${i + 1} nombre completo`,
			});

			label.append(labelText, input);
			container.append(label);
		}
	}

	function clearGuestNameFields() {
		const container = document.getElementById('rsvp-guest-names-fields');
		if (container) container.innerHTML = '';
	}

	function clearMessageField() {
		const messageInput = document.getElementById('rsvp-message') as HTMLTextAreaElement | null;
		if (messageInput) messageInput.value = '';
	}

	function collectGuestNames(): string[] {
		const container = document.getElementById('rsvp-guest-names-fields');
		if (!container) return [];
		return Array.from(container.querySelectorAll<HTMLInputElement>('input')).map((el) =>
			el.value.trim()
		);
	}

	function syncFormUI(opts: { preserveNames?: boolean } = {}) {
		const partyWrap = document.getElementById('rsvp-party-wrap');
		const attendingFields = document.getElementById('rsvp-attending-fields');
		const hint = document.getElementById('rsvp-party-hint');
		const display = document.getElementById('rsvp-count-display') as HTMLInputElement | null;
		const hidden = document.getElementById('rsvp-count') as HTMLInputElement | null;
		const decrease = document.getElementById('rsvp-count-decrease') as HTMLButtonElement | null;
		const increase = document.getElementById('rsvp-count-increase') as HTMLButtonElement | null;

		if (!partyWrap || !attendingFields || !hint || !display || !hidden || !decrease || !increase) {
			return;
		}

		const attending = isAttending();
		attendingFields.hidden = !attending;
		partyWrap.hidden = !attending;

		if (!attending) {
			hidden.value = '0';
			return;
		}

		currentCount = clampCount(currentCount, currentMax);
		display.value = String(currentCount);
		hidden.value = String(currentCount);
		decrease.disabled = currentCount <= 1;
		increase.disabled = currentCount >= currentMax;

		hint.textContent = reservedSeatsMessage(currentMax);

		const names = opts.preserveNames ? collectGuestNames() : [];
		renderGuestNameFields(currentCount, names);
	}

	function showFormBody(show: boolean) {
		const body = document.getElementById('rsvp-form-body');
		if (body) body.classList.toggle('hidden', !show);
	}

	function setNameStatus(
		type: 'found' | 'not-found' | 'loading' | 'search-error' | 'hidden',
		message = ''
	) {
		const el = document.getElementById('rsvp-name-status');
		if (!el) return;

		if (type === 'hidden') {
			el.classList.add('hidden');
			return;
		}

		el.classList.remove('hidden', 'text-olive', 'text-mauve-dark', 'text-brown-muted');
		if (type === 'found') el.classList.add('text-olive');
		else if (type === 'not-found' || type === 'search-error') el.classList.add('text-mauve-dark');
		else el.classList.add('text-brown-muted');
		el.textContent = message;
	}

	function closeDropdown() {
		const dropdown = document.getElementById('rsvp-name-dropdown');
		const searchInput = document.getElementById('rsvp-name-search') as HTMLInputElement | null;
		dropdown?.classList.add('hidden');
		searchInput?.setAttribute('aria-expanded', 'false');
	}

	function updateInviteBanner() {
		const banner = document.getElementById('rsvp-invite-banner');
		const label = document.getElementById('rsvp-invite-banner-label');
		const nameEl = document.getElementById('rsvp-invite-banner-name');
		const seatsEl = document.getElementById('rsvp-invite-banner-seats');
		if (!banner || !label || !nameEl || !seatsEl) return;

		if (fromInviteLink && selectedGuest) {
			label.textContent = pick({
				en: 'Invite for',
				es: 'Invitación para',
			});
			nameEl.textContent = selectedGuest.full_name;
			seatsEl.textContent = welcomeMessage(selectedGuest.full_name, selectedGuest.maxGuests);
			banner.classList.remove('hidden');
		} else {
			banner.classList.add('hidden');
			label.textContent = '';
			nameEl.textContent = '';
			seatsEl.textContent = '';
		}
	}

	function setInviteLinkMode(active: boolean) {
		fromInviteLink = active;
		const searchWrap = document.getElementById('rsvp-name-search-wrap');
		const selectedWrap = document.getElementById('rsvp-selected-guest');
		searchWrap?.classList.toggle('hidden', active);
		selectedWrap?.classList.toggle('hidden', active || !selectedGuest);
		updateInviteBanner();
	}

	function clearGuestSelection() {
		selectedGuest = null;
		fromInviteLink = false;
		showFormBody(false);
		clearGuestNameFields();
		clearMessageField();

		const guestIdInput = document.getElementById('rsvp-guest-id') as HTMLInputElement | null;
		const nameInput = document.getElementById('rsvp-guest-name') as HTMLInputElement | null;
		const inviteInput = document.getElementById('rsvp-invite-code') as HTMLInputElement | null;
		const firstName = document.getElementById('rsvp-first-name') as HTMLInputElement | null;
		const lastName = document.getElementById('rsvp-last-name') as HTMLInputElement | null;
		const selectedWrap = document.getElementById('rsvp-selected-guest');

		if (guestIdInput) guestIdInput.value = '';
		if (nameInput) nameInput.value = '';
		if (firstName) firstName.value = '';
		if (lastName) lastName.value = '';
		selectedWrap?.classList.add('hidden');
		if (inviteInput) {
			inviteInput.value = inviteInput.dataset.urlCode ?? '';
		}
		setInviteLinkMode(false);
	}

	async function applyGuestSelection(
		guest: GuestMatch,
		opts: { fromInvite?: boolean; existingRsvp?: LookupRsvp | null } = {}
	) {
		clearGuestNameFields();
		clearMessageField();

		selectedGuest = guest;
		currentMax = Math.max(1, guest.maxGuests);
		currentCount = currentMax;

		console.log('[RSVPForm] selected guest:', guest.full_name, 'maxGuests:', guest.maxGuests);

		const guestIdInput = document.getElementById('rsvp-guest-id') as HTMLInputElement | null;
		const nameInput = document.getElementById('rsvp-guest-name') as HTMLInputElement | null;
		const inviteInput = document.getElementById('rsvp-invite-code') as HTMLInputElement | null;
		const firstName = document.getElementById('rsvp-first-name') as HTMLInputElement | null;
		const lastName = document.getElementById('rsvp-last-name') as HTMLInputElement | null;
		const selectedWrap = document.getElementById('rsvp-selected-guest');
		const searchInput = document.getElementById('rsvp-name-search') as HTMLInputElement | null;

		if (guestIdInput) guestIdInput.value = guest.id;
		if (nameInput) nameInput.value = guest.full_name;
		if (inviteInput && guest.invite_code) inviteInput.value = guest.invite_code;
		if (firstName) firstName.value = guest.first_name ?? '';
		if (lastName) lastName.value = guest.last_name ?? '';

		if (opts.fromInvite) {
			setInviteLinkMode(true);
		} else {
			fromInviteLink = false;
			if (searchInput) searchInput.value = guest.full_name;
			selectedWrap?.classList.remove('hidden');
			updateInviteBanner();
		}

		closeDropdown();
		showFormBody(true);

		if (opts.fromInvite) {
			setNameStatus('hidden');
		} else {
			setNameStatus('found', welcomeMessage(guest.full_name, currentMax));
		}

		if (opts.existingRsvp !== undefined) {
			applyExistingRsvp(opts.existingRsvp, currentMax);
			return;
		}

		try {
			const res = await fetch(`/api/guest-lookup?id=${encodeURIComponent(guest.id)}`);
			const data = (await res.json()) as { ok?: boolean; rsvp?: LookupRsvp | null };
			if (res.ok && data.ok) {
				applyExistingRsvp(data.rsvp ?? null, currentMax);
			} else {
				applyExistingRsvp(null, currentMax);
			}
		} catch {
			applyExistingRsvp(null, currentMax);
		}
	}

	async function selectGuest(guest: GuestMatch) {
		await applyGuestSelection(guest);
	}

	async function loadGuestFromInviteCode(code: string) {
		const trimmed = code.trim();
		if (!trimmed) return;

		try {
			const res = await fetch(`/api/guest-lookup?invite_code=${encodeURIComponent(trimmed)}`);
			const data = (await res.json()) as {
				ok?: boolean;
				guest?: GuestMatch;
				rsvp?: LookupRsvp | null;
				error?: string;
			};

			if (!res.ok || !data.ok || !data.guest) {
				console.warn('[RSVPForm] invite code lookup failed:', data.error ?? res.status);
				return;
			}

			await applyGuestSelection(data.guest, {
				fromInvite: true,
				existingRsvp: data.rsvp ?? null,
			});
		} catch (err) {
			console.error('[RSVPForm] invite code lookup error:', err);
		}
	}

	function renderDropdown(guests: GuestMatch[]) {
		const dropdown = document.getElementById('rsvp-name-dropdown');
		const searchInput = document.getElementById('rsvp-name-search') as HTMLInputElement | null;
		if (!dropdown || !searchInput) return;

		dropdown.innerHTML = '';

		if (guests.length === 0) {
			closeDropdown();
			setNameStatus(
				'not-found',
				pick({
					en: 'No matching guest found. Please check your spelling.',
					es: 'No se encontró un invitado. Por favor verifica la ortografía.',
				})
			);
			return;
		}

		for (const guest of guests) {
			const li = document.createElement('li');
			li.setAttribute('role', 'presentation');

			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'rsvp-dropdown__option';
			btn.setAttribute('role', 'option');
			btn.textContent = guest.full_name;
			btn.addEventListener('click', () => {
				void selectGuest(guest);
			});

			li.append(btn);
			dropdown.append(li);
		}

		dropdown.classList.remove('hidden');
		searchInput.setAttribute('aria-expanded', 'true');
		setNameStatus('hidden');
	}

	async function searchGuests(query: string) {
		const trimmed = query.trim();
		activeSearchQuery = trimmed;

		if (trimmed.length < 2) {
			closeDropdown();
			setNameStatus('hidden');
			return;
		}

		setNameStatus('loading', pick({ en: 'Searching…', es: 'Buscando…' }));

		try {
			const res = await fetch(`/api/guest-search?q=${encodeURIComponent(trimmed)}`);
			const data = (await res.json()) as { ok?: boolean; guests?: GuestMatch[]; error?: string };

			if (activeSearchQuery !== trimmed) return;

			if (!res.ok || !data.ok) {
				closeDropdown();
				setNameStatus(
					'search-error',
					data.error ??
						pick({
							en: 'Could not search guest list. Please try again.',
							es: 'No se pudo buscar la lista de invitados. Por favor intenta de nuevo.',
						})
				);
				console.error('[RSVPForm] guest search failed:', data.error);
				return;
			}

			renderDropdown(data.guests ?? []);
			console.log('[RSVPForm] search query:', trimmed, 'matches:', data.guests?.length ?? 0);
		} catch (err) {
			if (activeSearchQuery !== trimmed) return;
			closeDropdown();
			setNameStatus(
				'search-error',
				pick({
					en: 'Could not search guest list. Please try again.',
					es: 'No se pudo buscar la lista de invitados. Por favor intenta de nuevo.',
				})
			);
			console.error('[RSVPForm] guest search error:', err);
		}
	}

	function applyExistingRsvp(rsvp: LookupRsvp | null, maxGuests: number) {
		clearGuestNameFields();
		clearMessageField();

		if (!rsvp) {
			currentCount = maxGuests;
			syncFormUI();
			return;
		}

		if (rsvp.attending) {
			document.querySelector<HTMLInputElement>('input[name="attending"][value="yes"]')!.checked = true;
			currentCount = maxGuests;
		} else {
			document.querySelector<HTMLInputElement>('input[name="attending"][value="no"]')!.checked = true;
			currentCount = maxGuests;
		}

		syncFormUI();
	}

	function initUI() {
		if (uiReady) {
			if (selectedGuest && isAttending()) {
				syncFormUI({ preserveNames: true });
			} else {
				syncFormUI();
			}
			return;
		}

		const searchInput = document.getElementById('rsvp-name-search') as HTMLInputElement | null;
		const inviteInput = document.getElementById('rsvp-invite-code') as HTMLInputElement | null;
		const searchWrap = document.getElementById('rsvp-name-search-wrap');
		const decrease = document.getElementById('rsvp-count-decrease');
		const increase = document.getElementById('rsvp-count-increase');
		const attendingRadios = document.querySelectorAll<HTMLInputElement>('input[name="attending"]');

		if (inviteInput?.value) {
			inviteInput.dataset.urlCode = inviteInput.value;
		}

		searchInput?.addEventListener('input', () => {
			if (!searchInput) return;
			if (selectedGuest && searchInput.value.trim() !== selectedGuest.full_name) {
				clearGuestSelection();
			}
			clearTimeout(searchTimer);
			searchTimer = setTimeout(() => searchGuests(searchInput.value), 300);
		});

		searchInput?.addEventListener('focus', () => {
			if (searchInput.value.trim().length >= 2) {
				void searchGuests(searchInput.value);
			}
		});

		document.addEventListener('click', (e) => {
			if (!searchWrap?.contains(e.target as Node)) {
				closeDropdown();
			}
		});

		decrease?.addEventListener('click', () => {
			if (!isAttending()) return;
			currentCount = clampCount(currentCount - 1, currentMax);
			syncFormUI({ preserveNames: true });
		});

		increase?.addEventListener('click', () => {
			if (!isAttending()) return;
			currentCount = clampCount(currentCount + 1, currentMax);
			syncFormUI({ preserveNames: true });
		});

		attendingRadios.forEach((radio) =>
			radio.addEventListener('change', () => {
				if (isAttending()) {
					syncFormUI({ preserveNames: true });
				} else {
					syncFormUI();
				}
			})
		);

		uiReady = true;

		const inviteCode = inviteInput?.value?.trim() || inviteInput?.dataset.urlCode?.trim() || '';
		if (inviteCode && inviteInput?.dataset.loadedInviteCode !== inviteCode) {
			inviteInput.dataset.loadedInviteCode = inviteCode;
			void loadGuestFromInviteCode(inviteCode);
		}
	}

	function renderSuccessView(rsvp: SubmittedRsvp) {
		const form = document.getElementById('rsvp-form');
		const success = document.getElementById('rsvp-success');
		const heading = document.getElementById('rsvp-success-heading');
		const namesEl = document.getElementById('rsvp-success-names');
		const messageEl = document.getElementById('rsvp-success-message');
		if (!form || !success || !heading || !namesEl || !messageEl) return;

		submittedRsvp = rsvp;
		form.classList.add('hidden');
		success.classList.remove('hidden');

		heading.textContent = pick({ en: 'Thank you!', es: '¡Gracias!' });

		namesEl.innerHTML = '';
		const inviteLabel = document.createElement('p');
		inviteLabel.className = 'text-xs font-medium uppercase tracking-wide text-brown-muted';
		inviteLabel.textContent = pick({ en: 'Invitation for', es: 'Invitación para' });
		namesEl.append(inviteLabel);

		const inviteName = document.createElement('p');
		inviteName.className = 'font-serif text-xl text-plum';
		inviteName.textContent = rsvp.name;
		namesEl.append(inviteName);

		if (rsvp.attending && rsvp.guestNames.length > 0) {
			const partyLabel = document.createElement('p');
			partyLabel.className = 'mt-4 text-xs font-medium uppercase tracking-wide text-brown-muted';
			partyLabel.textContent =
				rsvp.guestNames.length === 1 ?
					pick({ en: 'Attending', es: 'Asiste' })
				:	pick({ en: 'Attending', es: 'Asisten' });
			namesEl.append(partyLabel);

			const partyList = document.createElement('ul');
			partyList.className = 'mt-1 space-y-1 font-serif text-lg text-plum';
			for (const guest of rsvp.guestNames) {
				const li = document.createElement('li');
				li.textContent = guest;
				partyList.append(li);
			}
			namesEl.append(partyList);
		}

		if (rsvp.attending) {
			messageEl.textContent = pick({
				en: `We're so grateful you replied, ${rsvp.name}. We can't wait to celebrate with you!`,
				es: `Gracias por responder, ${rsvp.name}. ¡No podemos esperar a celebrar contigo!`,
			});
		} else {
			messageEl.textContent = pick({
				en: `Thank you for letting us know, ${rsvp.name}. We'll miss you, and we're sending love your way.`,
				es: `Gracias por avisarnos, ${rsvp.name}. Te extrañaremos y te enviamos cariño.`,
			});
		}
	}

	function refreshI18n() {
		const searchInput = document.getElementById('rsvp-name-search') as HTMLInputElement | null;
		if (searchInput?.dataset) {
			searchInput.placeholder = searchInput.dataset[isEs() ? 'phEs' : 'phEn'] ?? '';
		}
		const message = document.getElementById('rsvp-message') as HTMLTextAreaElement | null;
		if (message?.dataset) {
			message.placeholder = message.dataset[isEs() ? 'phEs' : 'phEn'] ?? '';
		}
		if (submittedRsvp) {
			renderSuccessView(submittedRsvp);
		} else if (selectedGuest) {
			if (fromInviteLink) {
				updateInviteBanner();
			} else {
				setNameStatus('found', welcomeMessage(selectedGuest.full_name, currentMax));
			}
			if (isAttending()) {
				syncFormUI({ preserveNames: true });
			} else {
				syncFormUI();
			}
		} else {
			syncFormUI();
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		initUI();
		refreshI18n();
	});
	window.addEventListener('wedding-lang', refreshI18n as EventListener);

	const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
	const statusEl = document.getElementById('rsvp-status');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!statusEl) return;

		const name =
			selectedGuest?.full_name ||
			String((document.getElementById('rsvp-guest-name') as HTMLInputElement | null)?.value ?? '').trim();
		const guestId = selectedGuest?.id ||
			String((document.getElementById('rsvp-guest-id') as HTMLInputElement | null)?.value ?? '').trim();
		const attending = isAttending();
		const guestNames = attending ? collectGuestNames() : [];
		let guestCount = attending ? guestNames.length : 0;
		const message = String(new FormData(form).get('message') ?? '').trim();
		const inviteCode = String(new FormData(form).get('inviteCode') ?? '').trim();

		if (!selectedGuest || !guestId) {
			statusEl.classList.remove('hidden', 'text-olive');
			statusEl.classList.add('text-mauve-dark');
			statusEl.textContent = pick({
				en: 'Please select your name from the list.',
				es: 'Por favor selecciona tu nombre de la lista.',
			});
			return;
		}

		if (!name) {
			statusEl.classList.remove('hidden', 'text-olive');
			statusEl.classList.add('text-mauve-dark');
			statusEl.textContent = pick({
				en: 'Please enter your name first.',
				es: 'Por favor ingresa tu nombre primero.',
			});
			return;
		}

		if (attending) {
			if (guestNames.length === 0 || guestNames.some((n) => !n)) {
				statusEl.classList.remove('hidden', 'text-olive');
				statusEl.classList.add('text-mauve-dark');
				statusEl.textContent = pick({
					en: 'Please enter at least one name for everyone attending.',
					es: 'Por favor ingresa al menos un nombre por cada persona que asistirá.',
				});
				return;
			}
			if (guestNames.length > currentMax) {
				statusEl.classList.remove('hidden', 'text-olive');
				statusEl.classList.add('text-mauve-dark');
				statusEl.textContent = pick({
					en: `Your invitation reserves ${currentMax} seat(s). Please remove extra names.`,
					es: `Tu invitación reserva ${currentMax} asiento(s). Por favor elimina nombres extra.`,
				});
				return;
			}
			guestCount = guestNames.length;
		} else {
			guestCount = 0;
		}

		statusEl.classList.remove('hidden', 'text-olive', 'text-mauve-dark');
		statusEl.textContent = pick({ en: 'Sending…', es: 'Enviando…' });

		const firstName =
			selectedGuest.first_name ??
			String((document.getElementById('rsvp-first-name') as HTMLInputElement | null)?.value ?? '').trim();
		const lastName =
			selectedGuest.last_name ??
			String((document.getElementById('rsvp-last-name') as HTMLInputElement | null)?.value ?? '').trim();

		const totalAttending = attending ? guestCount : 0;
		console.log(
			'[RSVPForm] submitting RSVP:',
			name,
			'invite_code:',
			selectedGuest.invite_code,
			'maxGuests:',
			selectedGuest.maxGuests,
			'guest_names:',
			guestNames,
			'total_attending:',
			totalAttending
		);

		try {
			const res = await fetch('/api/rsvp', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name,
					first_name: firstName,
					last_name: lastName,
					guestId,
					attending,
					guestCount,
					guestNames,
					guest_names: guestNames,
					total_attending: totalAttending,
					message,
					inviteCode: selectedGuest.invite_code || inviteCode,
					invite_code: selectedGuest.invite_code || inviteCode,
				}),
			});
			const data = (await res.json()) as { ok?: boolean; error?: string };

			if (!res.ok || !data.ok) {
				statusEl.classList.add('text-mauve-dark');
				statusEl.textContent =
					data.error ??
					pick({
						en: 'Something went wrong. Please try again.',
						es: 'Algo salió mal. Por favor intenta de nuevo.',
					});
				return;
			}

			renderSuccessView({ name, attending, guestNames });
		} catch {
			statusEl.classList.add('text-mauve-dark');
			statusEl.textContent = pick({
				en: 'Network error. Please try again.',
				es: 'Error de red. Por favor intenta de nuevo.',
			});
		}
	});
</script>

