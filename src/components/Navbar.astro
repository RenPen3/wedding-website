---
import { REGISTRY_URL } from '../lib/site-urls';

type Props = {
	integrated?: boolean;
};

type NavLink = {
	href: string;
	en: string;
	es: string;
	external?: boolean;
};

const { integrated = false } = Astro.props;

const hash = (id: string) => (integrated ? `#${id}` : `/#${id}`);

const links: NavLink[] = [
	{ href: hash('details'), en: 'Details', es: 'Detalles' },
	{ href: hash('schedule'), en: 'Schedule', es: 'Itinerario' },
	{ href: REGISTRY_URL, en: 'Registry', es: 'Lista de regalos', external: true },
	{ href: '/gallery', en: 'Gallery', es: 'Galería' },
	{ href: hash('faq'), en: 'FAQ', es: 'Preguntas' },
	{ href: '/rsvp', en: 'RSVP', es: 'RSVP' },
];

const externalLinkProps = (link: NavLink) =>
	link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const linkClass = integrated
	? 'text-ivory/90 transition-colors hover:text-cream'
	: 'text-brown-soft transition-colors hover:text-olive';

const switchShellClass = integrated
	? 'border-ivory/35 bg-plum-deep/45 shadow-[inset_0_1px_0_rgb(255_255_255_/_0.08)] ring-ivory/15'
	: 'border-mauve/25 bg-white/70 shadow-[inset_0_1px_0_rgb(255_255_255_/_0.65)] ring-mauve/10';

const switchBtnClass = integrated
	? 'text-ivory/80 hover:text-cream aria-[pressed=true]:text-plum-deep'
	: 'text-brown-soft hover:text-plum-deep aria-[pressed=true]:text-cream';
---

<span id="primary-nav-label" class="sr-only">
	<span data-strand="en">Primary navigation</span>
	<span data-strand="es">Navegación principal</span>
</span>
<span id="language-control-label" class="sr-only">
	<span data-strand="en">Site language</span>
	<span data-strand="es">Idioma del sitio</span>
</span>

{
	integrated ? (
		<header
			class="fixed inset-x-0 top-0 z-50 w-full pt-5 transition-[background-color,box-shadow,border-color,padding] duration-300 ease-out md:pt-6"
			data-nav-integrated
		>
			<nav
				class="mx-auto flex w-full max-w-6xl flex-col items-center px-5 md:px-8"
				aria-labelledby="primary-nav-label"
			>
				<div class="relative grid w-full grid-cols-1 gap-y-4 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center sm:gap-x-4 sm:gap-y-0">
					<a
						href="/"
						class="nav-brand pointer-events-none invisible hidden items-center opacity-0 transition-[opacity,visibility,color] duration-300 sm:col-start-1 sm:row-start-1 sm:flex sm:justify-self-start font-serif text-lg tracking-wide text-cream md:text-xl"
						data-nav-brand
					>
						Jocelyn & René
					</a>
					<ul class="col-start-1 row-start-2 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-2 p-0 text-center text-sm font-medium sm:col-start-2 sm:row-start-1 md:gap-x-11">
						{
							links.map((l) => (
								<li class="list-none">
									<a
										href={l.href}
										class:list={[linkClass, 'nav-link']}
										data-nav-link
										{...externalLinkProps(l)}
									>
										<span data-strand="en">{l.en}</span>
										<span data-strand="es">{l.es}</span>
									</a>
								</li>
							))
						}
					</ul>
					<div
						class="col-start-1 row-start-1 flex justify-end sm:col-start-3 sm:row-start-1 sm:justify-self-end [&:focus-within]:z-10"
						aria-labelledby="language-control-label"
					>
						<div
							id="language-switch"
							class:list={[
								'language-switch relative isolate inline-flex h-9 w-[7.125rem] shrink-0 rounded-full border backdrop-blur-sm ring-1 transition-[background-color,border-color,box-shadow] duration-300 [&:focus-within]:ring-2 [&:focus-within]:ring-ivory/30',
								switchShellClass,
							]}
							role="group"
						>
							<span
								class="lang-knob pointer-events-none absolute left-[6px] top-1 bottom-1 z-0 w-[calc(50%-10px)] rounded-full bg-cream shadow-inner shadow-black/20 transition-[transform,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
								aria-hidden="true"
								data-lang-knob
								data-shifted="false"
							/>
							<button
								type="button"
								data-lang="en"
								class:list={[
									'lang-btn relative z-[1] flex min-h-9 min-w-0 flex-1 items-center justify-center rounded-full px-2 text-[10px] font-semibold uppercase tracking-[0.22em] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-cream/50',
									switchBtnClass,
								]}
								aria-pressed="true"
								aria-label="English">EN</button
							>
							<button
								type="button"
								data-lang="es"
								class:list={[
									'lang-btn relative z-[1] flex min-h-9 min-w-0 flex-1 items-center justify-center rounded-full px-2 text-[10px] font-semibold uppercase tracking-[0.2em] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-cream/50',
									switchBtnClass,
								]}
								aria-pressed="false"
								aria-label="Español">ES</button
							>
						</div>
					</div>
				</div>
			</nav>
		</header>
	) : (
		<header class="sticky top-0 z-50 border-b border-mauve/20 bg-cream/90 backdrop-blur-md">
			<nav
				class="mx-auto flex w-full max-w-6xl flex-col items-center px-5 py-4 md:px-8 md:py-5"
				aria-labelledby="primary-nav-label"
			>
				<div class="relative grid w-full grid-cols-1 gap-y-4 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center sm:gap-x-4 sm:gap-y-0">
					<div class="hidden sm:col-start-1 sm:row-start-1 sm:block" aria-hidden="true" />
					<ul class="col-start-1 row-start-2 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-2 p-0 text-center text-sm font-medium sm:col-start-2 sm:row-start-1 md:gap-x-11">
						{
							links.map((l) => (
								<li class="list-none">
									<a href={l.href} class={linkClass} {...externalLinkProps(l)}>
										<span data-strand="en">{l.en}</span>
										<span data-strand="es">{l.es}</span>
									</a>
								</li>
							))
						}
					</ul>
					<div
						class="col-start-1 row-start-1 flex justify-end sm:col-start-3 sm:row-start-1 sm:justify-self-end [&:focus-within]:z-10"
						aria-labelledby="language-control-label"
					>
						<div
							id="language-switch"
							class:list={[
								'relative isolate inline-flex h-9 w-[7.125rem] shrink-0 rounded-full border backdrop-blur-sm ring-1 [&:focus-within]:ring-2 [&:focus-within]:ring-plum-deep/20',
								switchShellClass,
							]}
							role="group"
						>
							<span
								class="pointer-events-none absolute left-[6px] top-1 bottom-1 z-0 w-[calc(50%-10px)] rounded-full bg-plum-deep/93 shadow-inner shadow-black/15 transition-[transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
								aria-hidden="true"
								data-lang-knob
								data-shifted="false"
							/>
							<button
								type="button"
								data-lang="en"
								class:list={[
									'relative z-[1] flex min-h-9 min-w-0 flex-1 items-center justify-center rounded-full px-2 text-[10px] font-semibold uppercase tracking-[0.22em] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-plum-deep/30',
									switchBtnClass,
								]}
								aria-pressed="true"
								aria-label="English">EN</button
							>
							<button
								type="button"
								data-lang="es"
								class:list={[
									'relative z-[1] flex min-h-9 min-w-0 flex-1 items-center justify-center rounded-full px-2 text-[10px] font-semibold uppercase tracking-[0.2em] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-plum-deep/30',
									switchBtnClass,
								]}
								aria-pressed="false"
								aria-label="Español">ES</button
							>
						</div>
					</div>
				</div>
			</nav>
		</header>
	)
}

<script>
	const STORAGE_KEY = 'wedding-lang';

	type Lang = 'en' | 'es';

	type WeddingLangDetail = { lang: Lang };

	function getLang(): Lang {
		return document.documentElement.classList.contains('lang-es') ? 'es' : 'en';
	}

	function setKnobPosition(lang: Lang) {
		document.querySelectorAll<HTMLElement>('[data-lang-knob]').forEach((knob) => {
			knob.dataset.shifted = lang === 'es' ? 'true' : 'false';
		});
	}

	function broadcastLang(lang: Lang) {
		window.dispatchEvent(new CustomEvent<WeddingLangDetail>('wedding-lang', { detail: { lang } }));
	}

	function applyLang(lang: Lang) {
		const isEs = lang === 'es';
		document.documentElement.classList.toggle('lang-es', isEs);
		document.documentElement.setAttribute('lang', isEs ? 'es' : 'en');

		try {
			localStorage.setItem(STORAGE_KEY, lang);
		} catch {
			/* ignore */
		}

		document.querySelectorAll<HTMLButtonElement>('#language-switch [data-lang]').forEach((btn) => {
			const pressed = btn.dataset.lang === lang;
			btn.setAttribute('aria-pressed', String(pressed));
		});

		setKnobPosition(lang);
		broadcastLang(lang);
	}

	document.addEventListener('DOMContentLoaded', () => {
		const root = document.getElementById('language-switch');

		root?.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const lang = btn.dataset.lang;
				if (lang !== 'en' && lang !== 'es') return;
				const next: Lang = lang;
				if (next !== getLang()) applyLang(next);
			});

			btn.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
				e.preventDefault();
				const other: Lang = btn.dataset.lang === 'en' ? 'es' : 'en';
				if (other !== getLang()) applyLang(other);
				root.querySelector<HTMLButtonElement>(`button[data-lang="${other}"]`)?.focus();
			});
		});

		let stored: Lang = 'en';
		try {
			if (localStorage.getItem(STORAGE_KEY) === 'es') stored = 'es';
		} catch {
			stored = 'en';
		}

		applyLang(stored);

		const integratedNav = document.querySelector<HTMLElement>('[data-nav-integrated]');
		if (integratedNav) {
			const setNavHeight = () => {
				document.documentElement.style.setProperty(
					'--site-nav-height',
					`${integratedNav.offsetHeight}px`,
				);
			};

			const updateNavScroll = () => {
				const threshold = Math.max(32, integratedNav.offsetHeight * 0.45);
				integratedNav.classList.toggle('is-scrolled', window.scrollY > threshold);
			};

			setNavHeight();
			updateNavScroll();
			window.addEventListener('scroll', updateNavScroll, { passive: true });
			window.addEventListener('resize', () => {
				setNavHeight();
				updateNavScroll();
			});
		}
	});
</script>

<style is:inline>
	[data-lang-knob][data-shifted='true'] {
		transform: translate3d(calc(100% + 13px), 0, 0);
	}

	[data-nav-integrated].is-scrolled {
		border-bottom: 1px solid rgb(155 123 142 / 0.2);
		background-color: rgb(250 246 240 / 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		padding-bottom: 0.75rem;
	}

	@media (min-width: 768px) {
		[data-nav-integrated].is-scrolled {
			padding-bottom: 1rem;
		}
	}

	[data-nav-integrated].is-scrolled [data-nav-link] {
		color: rgb(139 115 85);
	}

	[data-nav-integrated].is-scrolled [data-nav-link]:hover {
		color: rgb(107 115 73);
	}

	[data-nav-integrated].is-scrolled .language-switch {
		border-color: rgb(155 123 142 / 0.25);
		background-color: rgb(255 255 255 / 0.7);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.65);
		--tw-ring-color: rgb(155 123 142 / 0.1);
	}

	[data-nav-integrated].is-scrolled .language-switch:focus-within {
		--tw-ring-color: rgb(42 26 50 / 0.2);
	}

	[data-nav-integrated].is-scrolled .lang-knob {
		background-color: rgb(42 26 50 / 0.93);
		box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.15);
	}

	[data-nav-integrated].is-scrolled .lang-btn {
		color: rgb(139 115 85);
	}

	[data-nav-integrated].is-scrolled .lang-btn:hover {
		color: rgb(42 26 50);
	}

	[data-nav-integrated].is-scrolled .lang-btn[aria-pressed='true'] {
		color: rgb(250 246 240);
	}

	[data-nav-integrated].is-scrolled [data-nav-brand] {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		color: rgb(61 38 69);
	}

	[data-nav-integrated].is-scrolled [data-nav-brand]:hover {
		color: rgb(107 115 73);
	}
</style>
