---
---

<section
	id="countdown"
	class="scroll-mt-24 bg-gradient-to-b from-plum-deep/10 to-cream py-16 md:py-20"
	aria-labelledby="countdown-heading"
	data-reveal
>
	<div class="mx-auto max-w-4xl px-6 md:px-8">
		<h2 id="countdown-heading" class="text-center font-serif text-3xl text-plum md:text-4xl">
			<span data-strand="en">The big day draws near</span>
			<span data-strand="es">Falta poco para el gran día</span>
		</h2>
		<div class="mx-auto mt-4 h-px w-24 bg-mauve/60" aria-hidden="true"></div>
		<p class="mx-auto mt-6 max-w-lg text-center text-brown-soft md:text-lg">
			<span data-strand="en">September 12, 2026 · Ceremony at 4:30 in the afternoon (Pacific Time)</span>
			<span data-strand="es"
				>12 de septiembre de 2026 · Ceremonia a las 4:30 de la tarde (hora del Pacífico)</span
			>
		</p>

		<div
			id="countdown-root"
			class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-5"
			role="group"
			data-target="2026-09-12T23:30:00.000Z"
			aria-labelledby="countdown-heading"
			hidden
		>
			<div class="rounded-2xl border border-mauve/15 bg-ivory/90 p-5 text-center shadow-sm md:p-6">
				<p class="font-serif text-4xl tabular-nums text-plum md:text-5xl" data-unit="days">—</p>
				<p class="mt-2 text-xs font-semibold uppercase tracking-wider text-olive">
					<span data-strand="en">Days</span>
					<span data-strand="es">Días</span>
				</p>
			</div>
			<div class="rounded-2xl border border-mauve/15 bg-ivory/90 p-5 text-center shadow-sm md:p-6">
				<p class="font-serif text-4xl tabular-nums text-plum md:text-5xl" data-unit="hours">—</p>
				<p class="mt-2 text-xs font-semibold uppercase tracking-wider text-olive">
					<span data-strand="en">Hours</span>
					<span data-strand="es">Horas</span>
				</p>
			</div>
			<div class="rounded-2xl border border-mauve/15 bg-ivory/90 p-5 text-center shadow-sm md:p-6">
				<p class="font-serif text-4xl tabular-nums text-plum md:text-5xl" data-unit="minutes">—</p>
				<p class="mt-2 text-xs font-semibold uppercase tracking-wider text-olive">
					<span data-strand="en">Minutes</span>
					<span data-strand="es">Minutos</span>
				</p>
			</div>
			<div class="rounded-2xl border border-mauve/15 bg-ivory/90 p-5 text-center shadow-sm md:p-6">
				<p class="font-serif text-4xl tabular-nums text-plum md:text-5xl" data-unit="seconds">—</p>
				<p class="mt-2 text-xs font-semibold uppercase tracking-wider text-olive">
					<span data-strand="en">Seconds</span>
					<span data-strand="es">Segundos</span>
				</p>
			</div>
		</div>

		<p id="countdown-complete" class="mt-10 hidden rounded-2xl border border-mauve/15 bg-ivory/90 px-6 py-10 text-center font-serif text-xl text-plum md:text-2xl" role="status">
			<span data-strand="en">We&apos;re celebrating!</span>
			<span data-strand="es">¡Lo estamos celebrando!</span>
		</p>
	</div>
</section>

<script>
	function pad(n: number) {
		return String(n).padStart(2, '0');
	}

	function attachCountdown(root: HTMLElement) {
		const complete = document.getElementById('countdown-complete');
		const rawTarget = root.dataset.target;
		if (!rawTarget) return;

		const target = new Date(rawTarget).getTime();
		const daysEl = root.querySelector<HTMLElement>('[data-unit="days"]');
		const hoursEl = root.querySelector<HTMLElement>('[data-unit="hours"]');
		const minutesEl = root.querySelector<HTMLElement>('[data-unit="minutes"]');
		const secondsEl = root.querySelector<HTMLElement>('[data-unit="seconds"]');
		let intervalId = 0;

		function render() {
			const now = Date.now();
			const diff = Math.max(0, target - now);

			if (diff === 0) {
				root.setAttribute('hidden', '');
				complete?.classList.remove('hidden');
				if (intervalId) window.clearInterval(intervalId);
				return;
			}

			root.hidden = false;
			const totalSeconds = Math.floor(diff / 1000);
			const days = Math.floor(totalSeconds / 86400);
			const hours = Math.floor((totalSeconds % 86400) / 3600);
			const minutes = Math.floor((totalSeconds % 3600) / 60);
			const seconds = totalSeconds % 60;

			if (daysEl) daysEl.textContent = String(days);
			if (hoursEl) hoursEl.textContent = pad(hours);
			if (minutesEl) minutesEl.textContent = pad(minutes);
			if (secondsEl) secondsEl.textContent = pad(seconds);
		}

		render();
		if (Date.now() < target) {
			intervalId = window.setInterval(render, 1000);
		}

		window.addEventListener(
			'beforeunload',
			() => {
				if (intervalId) window.clearInterval(intervalId);
			},
			{ once: true },
		);
	}

	document.addEventListener(
		'DOMContentLoaded',
		() => {
			const root = document.getElementById('countdown-root');
			if (root) attachCountdown(root as HTMLElement);
		},
		{ once: true },
	);
</script>
