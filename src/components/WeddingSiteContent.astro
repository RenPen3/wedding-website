---
import Hero from './Hero.astro';
import Countdown from './Countdown.astro';
import WeddingDetails from './WeddingDetails.astro';
import Registry from './Registry.astro';
import FAQ from './FAQ.astro';
import RSVPForm from './RSVPForm.astro';
import PhotoGallery from './PhotoGallery.astro';
import { CONTACT_EMAIL, CONTACT_PHONE_JOCELYN, CONTACT_PHONE_RENE } from '../lib/site-urls';
---

<Hero />
<Countdown />
<WeddingDetails />
<section id="rsvp" class="relative z-10 scroll-mt-24 bg-plum-deep py-20 text-cream md:py-28" data-reveal>
	<div class="mx-auto max-w-xl px-6 md:px-8">
		<h2 class="text-center font-serif text-3xl md:text-4xl">
			<span data-strand="en">Kindly respond</span>
			<span data-strand="es">Confirma tu asistencia</span>
		</h2>
		<p class="mx-auto mt-3 max-w-md text-center text-ivory/80">
			<span data-strand="en">
				We cannot wait to celebrate with you. Enter your name to find your invitation.
			</span>
			<span data-strand="es">
				No vemos la hora de celebrar contigo. Ingresa tu nombre para encontrar tu invitación.
			</span>
		</p>
		<div class="mt-10">
			<RSVPForm />
		</div>

		<div class="rsvp-help">
			<p>
				<span data-strand="en">
					Having trouble with the RSVP form? Contact us directly and we’ll help you.
				</span>
				<span data-strand="es">
					¿Tienes problemas con el formulario de RSVP? Contáctanos directamente y te ayudaremos.
				</span>
			</p>
			<div class="rsvp-help-contact">
				<div class="rsvp-help-phones">
					<ul class="rsvp-help-numbers">
						<li>René: {CONTACT_PHONE_RENE}</li>
						<li>Jocelyn: {CONTACT_PHONE_JOCELYN}</li>
					</ul>
				</div>
				<span class="rsvp-help-divider" aria-hidden="true">|</span>
				<span class="rsvp-help-email-wrap">
					<span data-strand="en">Email us: </span>
					<span data-strand="es">Escríbenos: </span>
					<a class="rsvp-help-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
				</span>
			</div>
		</div>
	</div>
</section>
<Registry homeStyle />
<PhotoGallery teaser homeStyle />
<FAQ homeStyle />

<style>
	.rsvp-help {
		margin-top: 1.5rem;
		text-align: center;
		font-size: 0.95rem;
		color: rgb(245 240 232 / 0.9);
	}

	.rsvp-help p {
		margin-bottom: 0.5rem;
		line-height: 1.5;
	}

	.rsvp-help-contact {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
	}

	.rsvp-help-phones {
		text-align: center;
	}

	.rsvp-help-numbers {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 0.75rem;
		line-height: 1.45;
	}

	.rsvp-help-numbers li + li::before {
		content: '·';
		margin-right: 0.75rem;
		opacity: 0.6;
	}

	.rsvp-help-email {
		display: inline-block;
		padding: 0.25rem 0.125rem;
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
		font-weight: 500;
	}

	.rsvp-help-email:hover {
		opacity: 0.75;
	}

	.rsvp-help-email:focus-visible {
		outline: 2px solid rgb(245 240 232 / 0.6);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.rsvp-help-divider {
		opacity: 0.5;
	}

	@media (max-width: 768px) {
		.rsvp-help {
			font-size: 0.9rem;
			margin-top: 1.25rem;
		}

		.rsvp-help-contact {
			flex-direction: column;
			gap: 0.625rem;
		}

		.rsvp-help-divider {
			display: none;
		}

		.rsvp-help-numbers {
			flex-direction: column;
			gap: 0.25rem;
		}

		.rsvp-help-numbers li + li::before {
			content: none;
		}
	}
</style>
