---
import Hero from './Hero.astro';
import Countdown from './Countdown.astro';
import WeddingDetails from './WeddingDetails.astro';
import Registry from './Registry.astro';
import FAQ from './FAQ.astro';
import RSVPForm from './RSVPForm.astro';
import PhotoGallery from './PhotoGallery.astro';
---

<Hero />
<Countdown />
<WeddingDetails />
<section id="rsvp" class="relative z-10 scroll-mt-24 bg-plum-deep py-20 text-cream md:py-28" data-reveal>
	<div class="mx-auto max-w-xl px-6 md:px-8">
		<h2 class="text-center font-serif text-3xl md:text-4xl">
			<span data-strand="en">Kindly respond</span>
			<span data-strand="es">Confirma tu asistencia</span>
		</h2>
		<p class="mx-auto mt-3 max-w-md text-center text-ivory/80">
			<span data-strand="en">
				We cannot wait to celebrate with you. Enter your name to find your invitation.
			</span>
			<span data-strand="es">
				No vemos la hora de celebrar contigo. Ingresa tu nombre para encontrar tu invitación.
			</span>
		</p>
		<div class="mt-10">
			<RSVPForm />
		</div>
	</div>
</section>
<Registry homeStyle />
<PhotoGallery teaser homeStyle />
<FAQ homeStyle />
