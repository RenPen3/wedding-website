---
/**
 * Invitation GIF preloader — shown once per session on the homepage.
 * Early `invitation-intro-seen` on <html> prevents flash (MainLayout).
 */
const INTRO_GIF_SRC = '/images/our-intro.gif';
---

<div
	id="invitation-intro"
	class="invitation-intro"
	data-invitation-intro
	role="dialog"
	aria-modal="true"
	aria-labelledby="invitation-intro-heading"
>
	<button
		type="button"
		class="invitation-intro__skip"
		data-invitation-skip
		aria-label="Skip invitation intro. Saltar introducción."
	>
		<span data-strand="en">Skip Intro</span>
		<span data-strand="es">Saltar intro</span>
	</button>

	<div class="invitation-intro__backdrop" aria-hidden="true">
		<div class="invitation-intro__glow" aria-hidden="true"></div>
	</div>

	<div class="invitation-intro__stage">
		<h2 id="invitation-intro-heading" class="sr-only">
			<span data-strand="en">Our wedding invitation</span>
			<span data-strand="es">Nuestra invitación de boda</span>
		</h2>

		<img
			class="invitation-intro__gif"
			src={INTRO_GIF_SRC}
			alt="Jocelyn and René wedding invitation"
			width="960"
			height="540"
			decoding="async"
			fetchpriority="high"
		/>
	</div>

	<button type="button" class="invitation-intro__continue" data-invitation-continue>
		<span data-strand="en">Enter Site</span>
		<span data-strand="es">Entrar al sitio</span>
	</button>
</div>

<script>
	const STORAGE_KEY = 'wedding-invitation-opened';
	const SEEN_CLASS = 'invitation-intro-seen';
	const ACTIVE_CLASS = 'invitation-intro-active';

	const root = document.documentElement;
	const overlay = document.querySelector<HTMLElement>('[data-invitation-intro]');

	if (!overlay) {
		/* no-op */
	} else {
		const skipBtn = overlay.querySelector<HTMLButtonElement>('[data-invitation-skip]');
		const continueBtn = overlay.querySelector<HTMLButtonElement>('[data-invitation-continue]');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const markSeen = () => {
			try {
				sessionStorage.setItem(STORAGE_KEY, '1');
			} catch {
				/* ignore */
			}
			root.classList.add(SEEN_CLASS);
		};

		const unlockScroll = () => root.classList.remove(ACTIVE_CLASS);

		const dismiss = () => {
			if (overlay.classList.contains('is-dismissed')) return;
			overlay.classList.add('is-dismissed', 'is-exiting');
			overlay.removeAttribute('role');
			overlay.removeAttribute('aria-modal');
			markSeen();
			unlockScroll();

			const removeOverlay = () => overlay.remove();

			if (reducedMotion) {
				removeOverlay();
				return;
			}

			overlay.addEventListener(
				'transitionend',
				(e) => {
					if (e.target === overlay) removeOverlay();
				},
				{ once: true }
			);
			window.setTimeout(removeOverlay, 1100);
		};

		const alreadySeen =
			root.classList.contains(SEEN_CLASS) ||
			(() => {
				try {
					return sessionStorage.getItem(STORAGE_KEY) === '1';
				} catch {
					return false;
				}
			})();

		if (alreadySeen) {
			overlay.remove();
		} else {
			root.classList.add(ACTIVE_CLASS);
			if (reducedMotion) overlay.classList.add('is-reduced-motion');

			skipBtn?.addEventListener('click', dismiss);
			continueBtn?.addEventListener('click', dismiss);

			window.setTimeout(() => {
				overlay.classList.add('is-ready');
				continueBtn?.focus({ preventScroll: true });
			}, reducedMotion ? 0 : 400);
		}
	}
</script>

<style>
	/* ── Session / scroll lock ───────────────────────────────────── */
	html.invitation-intro-seen [data-invitation-intro] {
		display: none !important;
	}

	html.invitation-intro-active {
		overflow: hidden;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ── Overlay ─────────────────────────────────────────────────── */
	.invitation-intro {
		--ease-out-soft: cubic-bezier(0.22, 1, 0.36, 1);

		position: fixed;
		inset: 0;
		z-index: 100;
		padding: 0;
		opacity: 1;
		visibility: visible;
		transition:
			opacity 0.9s var(--ease-out-soft) 0.15s,
			visibility 0.9s;
	}

	.invitation-intro.is-dismissed {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.invitation-intro__backdrop {
		position: absolute;
		inset: 0;
		background: #f7f2ea;
	}

	.invitation-intro__glow {
		display: none;
	}

	.invitation-intro__skip {
		position: absolute;
		top: clamp(0.85rem, 3vw, 1.5rem);
		right: clamp(0.85rem, 3vw, 1.5rem);
		z-index: 5;
		padding: 0.5rem 0.9rem;
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-brown-soft);
		background: rgb(255 255 255 / 0.5);
		border: 1px solid rgb(155 123 142 / 0.2);
		border-radius: 9999px;
		cursor: pointer;
		backdrop-filter: blur(10px);
		transition:
			color 0.25s ease,
			background-color 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.invitation-intro__skip:hover {
		color: var(--color-plum);
		background: rgb(255 255 255 / 0.82);
		border-color: rgb(155 123 142 / 0.32);
		box-shadow: 0 4px 20px rgb(42 26 50 / 0.08);
	}

	.invitation-intro__skip:focus-visible {
		outline: 2px solid var(--color-mauve);
		outline-offset: 2px;
	}

	/* ── Full-screen GIF ─────────────────────────────────────────── */
	.invitation-intro__stage {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		animation: intro-stage-in 0.9s var(--ease-out-soft) both;
	}

	.invitation-intro__gif {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.invitation-intro__continue {
		position: absolute;
		left: 50%;
		bottom: clamp(1.25rem, 4vw, 2rem);
		z-index: 5;
		transform: translateX(-50%);
		padding: 0.65rem 1.75rem;
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-plum-deep);
		background: linear-gradient(180deg, #faf6f0, #f0e8dc);
		border: 1px solid rgb(155 123 142 / 0.3);
		border-radius: 9999px;
		box-shadow: 0 4px 16px rgb(42 26 50 / 0.08);
		cursor: pointer;
		transition:
			color 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s ease;
	}

	.invitation-intro__continue:hover {
		color: var(--color-plum);
		border-color: rgb(155 123 142 / 0.45);
		box-shadow: 0 6px 22px rgb(155 123 142 / 0.22);
		transform: translateX(-50%) translateY(-1px);
	}

	.invitation-intro__continue:focus-visible {
		outline: 2px solid var(--color-mauve);
		outline-offset: 3px;
	}

	@keyframes intro-stage-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.invitation-intro.is-reduced-motion .invitation-intro__stage {
		animation: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.invitation-intro {
			transition: opacity 0.2s ease;
		}

		.invitation-intro__stage {
			animation: none !important;
		}
	}
</style>
