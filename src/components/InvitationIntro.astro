---
/**
 * Invitation video preloader — shown once per session on the homepage.
 * Plays once, then auto-dismisses after the video duration.
 */
const INTRO_VIDEO_SRC = '/videos/preloader_invitation.mp4';
/** Used if video duration is unavailable (seconds) */
const INTRO_DISMISS_FALLBACK_SEC = 10;
---

<div
	id="invitation-intro"
	class="invitation-intro"
	data-invitation-intro
	data-dismiss-fallback={INTRO_DISMISS_FALLBACK_SEC}
	aria-busy="true"
	aria-label="Wedding invitation intro"
>
	<div class="invitation-intro__backdrop" aria-hidden="true"></div>

	<div class="invitation-intro__stage">
		<h2 class="sr-only">
			<span data-strand="en">Our wedding invitation</span>
			<span data-strand="es">Nuestra invitación de boda</span>
		</h2>

		<div class="invitation-intro__frame">
			<video
				class="invitation-intro__media"
				src={INTRO_VIDEO_SRC}
				autoplay
				muted
				playsinline
				preload="auto"
				disablepictureinpicture
				aria-hidden="true"
			></video>
		</div>
	</div>
</div>

<script>
	const STORAGE_KEY = 'wedding-invitation-opened';
	const SEEN_CLASS = 'invitation-intro-seen';
	const ACTIVE_CLASS = 'invitation-intro-active';

	const root = document.documentElement;
	const overlay = document.querySelector<HTMLElement>('[data-invitation-intro]');

	if (!overlay) {
		/* no-op */
	} else {
		const video = overlay.querySelector<HTMLVideoElement>('.invitation-intro__media');
		const fallbackSec = Number(overlay.dataset.dismissFallback) || 10;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let dismissTimer: ReturnType<typeof setTimeout> | undefined;

		const markSeen = () => {
			try {
				sessionStorage.setItem(STORAGE_KEY, '1');
			} catch {
				/* ignore */
			}
			root.classList.add(SEEN_CLASS);
		};

		const unlockScroll = () => {
			root.classList.remove(ACTIVE_CLASS);
			document.body.style.removeProperty('position');
			document.body.style.removeProperty('width');
			document.body.style.removeProperty('top');
		};

		const dismiss = () => {
			if (overlay.classList.contains('is-dismissed')) return;
			window.clearTimeout(dismissTimer);
			overlay.classList.add('is-dismissed', 'is-exiting');
			overlay.removeAttribute('aria-busy');
			markSeen();
			unlockScroll();

			const removeOverlay = () => overlay.remove();

			if (reducedMotion) {
				removeOverlay();
				return;
			}

			overlay.addEventListener(
				'transitionend',
				(e) => {
					if (e.target === overlay) removeOverlay();
				},
				{ once: true },
			);
			window.setTimeout(removeOverlay, 1100);
		};

		const scheduleDismiss = (seconds: number) => {
			window.clearTimeout(dismissTimer);
			dismissTimer = window.setTimeout(dismiss, Math.max(0, seconds) * 1000);
		};

		const ensurePlayback = () => {
			if (!video || reducedMotion) return;
			void video.play().catch(() => scheduleDismiss(fallbackSec));
		};

		const alreadySeen =
			root.classList.contains(SEEN_CLASS) ||
			(() => {
				try {
					return sessionStorage.getItem(STORAGE_KEY) === '1';
				} catch {
					return false;
				}
			})();

		if (alreadySeen) {
			overlay.remove();
		} else {
			root.classList.add(ACTIVE_CLASS);
			document.body.style.position = 'fixed';
			document.body.style.width = '100%';
			document.body.style.top = '0';

			if (reducedMotion) {
				overlay.classList.add('is-reduced-motion');
				video?.pause();
				scheduleDismiss(Math.min(fallbackSec, 3));
			} else if (video) {
				let dismissScheduled = false;

				const scheduleFromVideo = () => {
					if (dismissScheduled) return;
					dismissScheduled = true;

					const duration =
						Number.isFinite(video.duration) && video.duration > 0
							? video.duration
							: fallbackSec;
					scheduleDismiss(duration);
				};

				video.addEventListener('loadedmetadata', scheduleFromVideo, { once: true });
				video.addEventListener('canplay', ensurePlayback, { once: true });
				video.addEventListener('ended', dismiss, { once: true });
				window.setTimeout(scheduleFromVideo, 1500);
				ensurePlayback();
			} else {
				scheduleDismiss(fallbackSec);
			}

			window.setTimeout(() => overlay.classList.add('is-ready'), reducedMotion ? 0 : 400);
		}
	}
</script>

<style>
	/* ── Session / scroll lock ───────────────────────────────────── */
	html.invitation-intro-seen [data-invitation-intro] {
		display: none !important;
	}

	html.invitation-intro-active {
		overflow: hidden;
	}

	html.invitation-intro-active body {
		overflow: hidden;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ── Overlay ─────────────────────────────────────────────────── */
	.invitation-intro {
		--ease-out-soft: cubic-bezier(0.22, 1, 0.36, 1);
		--intro-pad: clamp(0.5rem, 2.5vw, 1.5rem);

		position: fixed;
		inset: 0;
		z-index: 100;
		width: 100%;
		height: 100%;
		height: 100dvh;
		min-height: 100svh;
		padding:
			max(env(safe-area-inset-top, 0px), var(--intro-pad))
			max(env(safe-area-inset-right, 0px), var(--intro-pad))
			max(env(safe-area-inset-bottom, 0px), var(--intro-pad))
			max(env(safe-area-inset-left, 0px), var(--intro-pad));
		overflow: hidden;
		opacity: 1;
		visibility: visible;
		transition:
			opacity 0.9s var(--ease-out-soft) 0.15s,
			visibility 0.9s;
	}

	.invitation-intro.is-dismissed {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.invitation-intro__backdrop {
		position: absolute;
		inset: 0;
		background: #f7f2ea;
	}

	/* ── Responsive video stage ──────────────────────────────────── */
	.invitation-intro__stage {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		min-height: 0;
		animation: intro-stage-in 0.9s var(--ease-out-soft) both;
	}

	.invitation-intro__frame {
		display: flex;
		align-items: center;
		justify-content: center;
		width: min(100%, 26rem);
		height: min(100%, calc(100dvh - 2rem));
		max-height: 100%;
	}

	.invitation-intro__media {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		object-position: center;
		border-radius: clamp(0.25rem, 1.2vw, 0.75rem);
	}

	@keyframes intro-stage-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.invitation-intro.is-reduced-motion .invitation-intro__stage {
		animation: none !important;
	}

	@media (min-width: 480px) {
		.invitation-intro__frame {
			width: min(100%, 32rem);
		}
	}

	@media (min-width: 768px) {
		.invitation-intro {
			--intro-pad: clamp(1rem, 3vw, 2rem);
		}

		.invitation-intro__frame {
			width: min(92vw, 40rem);
			height: min(92dvh, 52rem);
		}
	}

	@media (min-width: 1024px) {
		.invitation-intro__frame {
			width: min(88vw, 48rem);
			height: min(90dvh, 56rem);
		}
	}

	@media (orientation: landscape) and (max-height: 32rem) {
		.invitation-intro {
			--intro-pad: clamp(0.35rem, 2vh, 0.75rem);
		}

		.invitation-intro__frame {
			width: min(92vw, calc(88dvh * 0.72));
			height: min(88dvh, 100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.invitation-intro {
			transition: opacity 0.2s ease;
		}

		.invitation-intro__stage {
			animation: none !important;
		}
	}
</style>
