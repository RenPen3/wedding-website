---
/**
 * Invitation video preloader — shown once per session on the homepage.
 * Plays once, then auto-dismisses after the video duration.
 */
const INTRO_VIDEO_SRC = '/videos/preloader_invitation.mp4';
/** Used if video duration is unavailable (seconds) */
const INTRO_DISMISS_FALLBACK_SEC = 10;
---

<div
	id="invitation-intro"
	class="invitation-intro"
	data-invitation-intro
	data-dismiss-fallback={INTRO_DISMISS_FALLBACK_SEC}
	aria-busy="true"
	aria-label="Wedding invitation intro"
>
	<div class="invitation-intro__backdrop" aria-hidden="true">
		<div class="invitation-intro__glow" aria-hidden="true"></div>
	</div>

	<div class="invitation-intro__stage">
		<h2 class="sr-only">
			<span data-strand="en">Our wedding invitation</span>
			<span data-strand="es">Nuestra invitación de boda</span>
		</h2>

		<video
			class="invitation-intro__media"
			src={INTRO_VIDEO_SRC}
			autoplay
			muted
			playsinline
			preload="auto"
			aria-hidden="true"
		></video>
	</div>
</div>

<script>
	const STORAGE_KEY = 'wedding-invitation-opened';
	const SEEN_CLASS = 'invitation-intro-seen';
	const ACTIVE_CLASS = 'invitation-intro-active';

	const root = document.documentElement;
	const overlay = document.querySelector<HTMLElement>('[data-invitation-intro]');

	if (!overlay) {
		/* no-op */
	} else {
		const video = overlay.querySelector<HTMLVideoElement>('.invitation-intro__media');
		const fallbackSec = Number(overlay.dataset.dismissFallback) || 10;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let dismissTimer: ReturnType<typeof setTimeout> | undefined;

		const markSeen = () => {
			try {
				sessionStorage.setItem(STORAGE_KEY, '1');
			} catch {
				/* ignore */
			}
			root.classList.add(SEEN_CLASS);
		};

		const unlockScroll = () => root.classList.remove(ACTIVE_CLASS);

		const dismiss = () => {
			if (overlay.classList.contains('is-dismissed')) return;
			window.clearTimeout(dismissTimer);
			overlay.classList.add('is-dismissed', 'is-exiting');
			overlay.removeAttribute('aria-busy');
			markSeen();
			unlockScroll();

			const removeOverlay = () => overlay.remove();

			if (reducedMotion) {
				removeOverlay();
				return;
			}

			overlay.addEventListener(
				'transitionend',
				(e) => {
					if (e.target === overlay) removeOverlay();
				},
				{ once: true },
			);
			window.setTimeout(removeOverlay, 1100);
		};

		const scheduleDismiss = (seconds: number) => {
			window.clearTimeout(dismissTimer);
			dismissTimer = window.setTimeout(dismiss, Math.max(0, seconds) * 1000);
		};

		const alreadySeen =
			root.classList.contains(SEEN_CLASS) ||
			(() => {
				try {
					return sessionStorage.getItem(STORAGE_KEY) === '1';
				} catch {
					return false;
				}
			})();

		if (alreadySeen) {
			overlay.remove();
		} else {
			root.classList.add(ACTIVE_CLASS);

			if (reducedMotion) {
				overlay.classList.add('is-reduced-motion');
				video?.pause();
				scheduleDismiss(Math.min(fallbackSec, 3));
			} else if (video) {
				let dismissScheduled = false;

				const scheduleFromVideo = () => {
					if (dismissScheduled) return;
					dismissScheduled = true;

					const duration =
						Number.isFinite(video.duration) && video.duration > 0
							? video.duration
							: fallbackSec;
					scheduleDismiss(duration);
				};

				if (video.readyState >= 1) {
					scheduleFromVideo();
				} else {
					video.addEventListener('loadedmetadata', scheduleFromVideo, { once: true });
					window.setTimeout(scheduleFromVideo, 1500);
				}

				video.addEventListener('ended', dismiss, { once: true });
			} else {
				scheduleDismiss(fallbackSec);
			}

			window.setTimeout(() => overlay.classList.add('is-ready'), reducedMotion ? 0 : 400);
		}
	}
</script>

<style>
	/* ── Session / scroll lock ───────────────────────────────────── */
	html.invitation-intro-seen [data-invitation-intro] {
		display: none !important;
	}

	html.invitation-intro-active {
		overflow: hidden;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ── Overlay ─────────────────────────────────────────────────── */
	.invitation-intro {
		--ease-out-soft: cubic-bezier(0.22, 1, 0.36, 1);

		position: fixed;
		inset: 0;
		z-index: 100;
		padding: 0;
		opacity: 1;
		visibility: visible;
		transition:
			opacity 0.9s var(--ease-out-soft) 0.15s,
			visibility 0.9s;
	}

	.invitation-intro.is-dismissed {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.invitation-intro__backdrop {
		position: absolute;
		inset: 0;
		background: #f7f2ea;
	}

	.invitation-intro__glow {
		display: none;
	}

	/* ── Full-screen video ───────────────────────────────────────── */
	.invitation-intro__stage {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		animation: intro-stage-in 0.9s var(--ease-out-soft) both;
	}

	.invitation-intro__media {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	@keyframes intro-stage-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.invitation-intro.is-reduced-motion .invitation-intro__stage {
		animation: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.invitation-intro {
			transition: opacity 0.2s ease;
		}

		.invitation-intro__stage {
			animation: none !important;
		}
	}
</style>
