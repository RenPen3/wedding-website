---
import { timelineItems } from '../lib/our-story';
---

<section
	class="bg-ivory py-16 md:py-24"
	aria-labelledby="story-timeline-heading"
>
	<div class="mx-auto max-w-5xl px-6 md:px-8">
		<div class="text-center" data-reveal>
			<h2 id="story-timeline-heading" class="font-serif text-3xl text-plum md:text-4xl">
				<span data-strand="en">Our timeline</span>
				<span data-strand="es">Nuestra línea de tiempo</span>
			</h2>
			<div class="mx-auto mt-4 h-px w-24 bg-mauve/60" aria-hidden="true"></div>
		</div>

		<ol class="story-timeline mt-12 list-none space-y-10 p-0 md:mt-16 md:space-y-14">
			{
				timelineItems.map((item, index) => (
					<li class="list-none" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
						<article class="story-timeline__card relative min-h-[22rem] overflow-hidden rounded-3xl shadow-md sm:min-h-[26rem] md:min-h-[30rem] md:rounded-[2rem]">
							<div
								class="absolute inset-0 scale-105 bg-cover bg-center transition duration-700"
								style={`background-image: url('${item.image}');`}
								role="img"
								aria-label={item.title.en}
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-plum-deep/92 via-plum-deep/55 to-plum-deep/20"
								aria-hidden="true"
							/>
							<div class="relative flex min-h-[22rem] flex-col justify-end px-7 py-9 sm:min-h-[26rem] sm:px-10 sm:py-11 md:min-h-[30rem] md:px-12 md:py-14">
								<p class="text-xs font-semibold uppercase tracking-[0.28em] text-ivory/75">
									<span data-strand="en">{item.date.en}</span>
									<span data-strand="es">{item.date.es}</span>
								</p>
								<h3 class="mt-3 font-serif text-3xl leading-tight text-cream sm:text-4xl md:text-[2.75rem]">
									<span data-strand="en">{item.title.en}</span>
									<span data-strand="es">{item.title.es}</span>
								</h3>
								<p class="mt-4 max-w-2xl text-base leading-relaxed text-ivory/90 sm:text-lg">
									<span data-strand="en">{item.text.en}</span>
									<span data-strand="es">{item.text.es}</span>
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>
