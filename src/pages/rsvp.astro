---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RSVPForm from '../components/RSVPForm.astro';

const initialCode = Astro.url.searchParams.get('code') ?? Astro.url.searchParams.get('slug') ?? '';
---

<MainLayout title="RSVP — Jocelyn & René">
	<Navbar />
	<main class="bg-ivory py-16 md:py-24">
		<div class="mx-auto max-w-xl px-6 md:px-8" data-reveal>
			<h1 class="text-center font-serif text-4xl text-plum md:text-5xl">RSVP</h1>
			<p class="mx-auto mt-4 max-w-md text-center text-brown-soft">
				<span data-strand="en">
					Share your reply by August 1, 2026. Use the invite code from your personal invitation link.
				</span>
				<span data-strand="es">
					Comparte tu respuesta antes del 1 de agosto de 2026. Usa el código de tu enlace personal.
				</span>
			</p>
			<div class="mt-10">
				<RSVPForm inviteCode={initialCode} />
			</div>
		</div>
	</main>
	<Footer />
</MainLayout>
