---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import RSVPForm from '../components/RSVPForm.astro';
import RsvpWeddingDetails from '../components/RsvpWeddingDetails.astro';
import Footer from '../components/Footer.astro';

const inviteCode = Astro.url.searchParams.get('code') ?? '';
---

<MainLayout title="RSVP — Jocelyn & René" showInvitationIntro>
	<Navbar />
	<main class="bg-ivory">
		<div
			class="mx-auto flex min-h-[100svh] min-h-[100dvh] w-full max-w-2xl flex-col justify-center px-6 py-[calc(var(--site-nav-height,6.5rem)+2.5rem)] md:px-8 md:py-[calc(var(--site-nav-height,6.5rem)+3rem)]"
			data-reveal
		>
			<h1 class="text-center font-serif text-4xl text-plum-deep md:text-5xl">RSVP</h1>
			<p class="mx-auto mt-4 max-w-md text-center text-plum-deep md:text-lg">
				<span data-strand="en"
					>We’d love to celebrate with you. Please RSVP by August 1, 2026—find your name below to get
					started.</span
				>
				<span data-strand="es"
					>Nos encantaría celebrar contigo. Por favor confirma tu asistencia antes del 1 de agosto de
					2026—busca tu nombre abajo para comenzar.</span>
			</p>

			<RsvpWeddingDetails />

			<div class="mt-8 md:mt-10">
				<RSVPForm inviteCode={inviteCode} showHeader={false} />
			</div>
		</div>
	</main>
	<Footer />
</MainLayout>
