---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import RSVPForm from '../components/RSVPForm.astro';
import Footer from '../components/Footer.astro';
import { getState } from '../lib/wedding-store';

const { guests, rsvps } = await getState();
const initialSlug = Astro.url.searchParams.get('slug') ?? '';
---

<MainLayout title="RSVP — Jordan & Riley">
	<Navbar />
		<main class="bg-ivory py-16 md:py-24">
		<div class="mx-auto max-w-xl px-6 md:px-8" data-reveal>
			<h1 class="text-center font-serif text-4xl text-plum md:text-5xl">RSVP</h1>
			<p class="mx-auto mt-4 max-w-md text-center text-brown-soft">
				<span data-strand="en"
					>Share your reply by August 1, 2026. Your guest slug is included in your personal invitation
					link.</span
				><span data-strand="es"
					>Comparte tu respuesta antes del 1 de agosto de 2026. Tu enlace incluye tu identificador de
					invitado.</span>
			</p>
			<div class="mt-10">
				<RSVPForm guests={guests} rsvps={rsvps} initialSlug={initialSlug} />
			</div>
		</div>
	</main>
	<Footer />
</MainLayout>
