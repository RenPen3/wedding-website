---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import RSVPForm from '../components/RSVPForm.astro';
import Footer from '../components/Footer.astro';

const initialName = Astro.url.searchParams.get('name') ?? '';
---

<MainLayout title="RSVP — Jocelyn & René">
	<Navbar />
	<main class="bg-ivory py-16 md:py-24">
		<div class="mx-auto max-w-xl px-6 md:px-8" data-reveal>
			<h1 class="text-center font-serif text-4xl text-plum md:text-5xl">RSVP</h1>
			<p class="mx-auto mt-4 max-w-md text-center text-brown-soft">
				<span data-strand="en"
					>Share your reply by August 1, 2026. Enter your name exactly as it appears on your
					invitation.</span
				>
				<span data-strand="es"
					>Comparte tu respuesta antes del 1 de agosto de 2026. Ingresa tu nombre tal como aparece en
					tu invitación.</span>
			</p>
			<div class="mt-10">
				<RSVPForm initialName={initialName} />
			</div>
		</div>
	</main>
	<Footer />
</MainLayout>
