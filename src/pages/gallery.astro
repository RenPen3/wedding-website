---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import SlideshowViewer from '../components/SlideshowViewer.astro';
import { galleryDescription } from '../lib/gallery-copy';
---

<MainLayout title="Wedding Gallery — Jocelyn & René">
	<Navbar />
	<main class="bg-ivory">
		<div class="border-b border-mauve/15 bg-cream py-12 md:py-16" data-reveal>
			<div class="mx-auto max-w-5xl px-6 text-center md:px-8">
				<h1 class="font-serif text-4xl text-plum md:text-5xl">
					<span data-strand="en">Wedding gallery</span>
					<span data-strand="es">Galería de la boda</span>
				</h1>
				<div class="mx-auto mt-4 h-px w-24 bg-mauve/60" aria-hidden="true"></div>
				<p class="mx-auto mt-6 max-w-2xl text-brown-soft">
					<span data-strand="en">{galleryDescription.en}</span>
					<span data-strand="es">{galleryDescription.es}</span>
				</p>
			</div>
		</div>
		<SlideshowViewer />
		<PhotoGallery showHeader={false} />
	</main>
	<Footer />
</MainLayout>
