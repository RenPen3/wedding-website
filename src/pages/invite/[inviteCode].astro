---
const code = (Astro.params.inviteCode ?? '').trim().toLowerCase();
const target = code ? `/rsvp?code=${encodeURIComponent(code)}` : '/rsvp';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Opening invitation…</title>
	</head>
	<body>
		<p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center; color: #444">
			Opening your invitation…
		</p>
		<script define:vars={{ code, target }}>
			if (code) {
				const storageKey = `invite_open_logged_${code}`;

				try {
					if (!sessionStorage.getItem(storageKey)) {
						sessionStorage.setItem(storageKey, 'true');

						fetch('/.netlify/functions/track-invite-open', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({ slug: code }),
						}).catch(() => {
							// Fail silently. Do not block invite page.
						});
					}
				} catch (_) {
					/* sessionStorage unavailable */
				}
			}

			window.location.replace(target);
		</script>
	</body>
</html>
