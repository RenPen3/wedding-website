---
import {
	isValidInviteCode,
	normalizeInviteCode,
	recordInviteOpen,
} from '../../lib/invite-opens';

const code = normalizeInviteCode(Astro.params.inviteCode ?? '');
const target = code ? `/rsvp?code=${encodeURIComponent(code)}` : '/rsvp';

if (code && isValidInviteCode(code)) {
	const result = await recordInviteOpen({
		invite_code: code,
		page_path: `/invite/${code}`,
		user_agent: Astro.request.headers.get('user-agent'),
	});
	console.log('[invite] server-side track:', code, result.ok ? 'success' : result.error);
} else if (code) {
	console.warn('[invite] invalid slug:', code);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Opening invitation…</title>
	</head>
	<body>
		<p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center; color: #444">
			Opening your invitation…
		</p>
		<script define:vars={{ code, target }}>
			const SESSION_PREFIX = 'wedding-invite-tracked:';

			if (code) {
				try {
					sessionStorage.setItem(SESSION_PREFIX + code, '1');
				} catch (_) {}
			}
			window.location.replace(target);
		</script>
	</body>
</html>
