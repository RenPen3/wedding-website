---
/** Legacy /invite/{code} URLs → homepage with invite_code (tracking runs on homepage). */
import { INVITE_CODE_PARAM } from '../../lib/invite-link';

const code = (Astro.params.inviteCode ?? '').trim().toLowerCase();
const target =
	code ?
		`/?${INVITE_CODE_PARAM}=${encodeURIComponent(code)}`
	:	'/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Opening invitation…</title>
		<meta http-equiv="refresh" content={`0;url=${target}`} />
	</head>
	<body>
		<p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center; color: #444">
			Opening your invitation…
		</p>
		<script define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</body>
</html>
