---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSiteUrl } from '../../lib/site-urls';

const requestOrigin = Astro.url.origin;
const SITE_URL = getSiteUrl(requestOrigin);
const SESSION_KEY = 'wedding_admin_token';
---

<MainLayout
	title="Guest admin — Jocelyn & René"
	description="Private guest invitation and RSVP dashboard."
	showInvitationIntro={false}
>
	<div id="admin-guests-app" class="admin-guests min-h-screen bg-ivory">
		<!-- Password gate -->
		<div
			id="admin-login"
			class="flex min-h-screen flex-col items-center justify-center px-6 py-20"
		>
			<div class="w-full max-w-sm rounded-3xl border border-mauve/20 bg-cream p-8 shadow-sm">
				<h1 class="font-serif text-3xl text-plum">Guest admin</h1>
				<p class="mt-2 text-sm text-brown-soft">Enter the admin password to view invitation data.</p>
				<form id="admin-login-form" class="mt-8 space-y-4">
					<div>
						<label for="admin-password" class="block text-sm font-medium text-plum">Password</label>
						<input
							type="password"
							id="admin-password"
							name="password"
							required
							autocomplete="current-password"
							class="mt-2 w-full rounded-xl border border-mauve/25 bg-white px-4 py-3 text-plum-deep outline-none ring-olive/40 focus:ring-2"
						/>
					</div>
					<p id="admin-login-error" class="hidden text-sm text-mauve-dark" role="alert"></p>
					<button
						type="submit"
						class="w-full rounded-full bg-plum px-6 py-3 font-medium text-cream transition hover:bg-mauve-dark"
					>
						Sign in
					</button>
				</form>
			</div>
		</div>

		<!-- Dashboard -->
		<div id="admin-dashboard" class="hidden pb-20 pt-10 md:pt-12">
			<div class="mx-auto max-w-7xl px-4 md:px-8">
				<header class="flex flex-wrap items-end justify-between gap-4 border-b border-mauve/15 pb-6">
					<div>
						<h1 class="font-serif text-4xl text-plum">Guest invitations</h1>
						<p class="mt-1 text-sm text-brown-soft">
							Tracking opens and RSVPs · <span id="guest-count-label">—</span> guests
						</p>
					</div>
					<div class="flex flex-wrap gap-2">
						<a
							href="/admin/slideshow"
							class="rounded-full border border-mauve/25 bg-cream px-5 py-2 text-sm font-medium text-brown-soft transition hover:border-plum hover:text-plum"
						>
							AI Slideshow
						</a>
						<button
							type="button"
							id="admin-clear-rsvps"
							class="rounded-full border border-mauve-dark/30 bg-cream px-5 py-2 text-sm font-medium text-mauve-dark transition hover:border-mauve-dark hover:bg-mauve-dark hover:text-cream"
						>
							Clear test RSVPs
						</button>
						<button
							type="button"
							id="admin-sign-out"
							class="rounded-full border border-mauve/25 bg-cream px-5 py-2 text-sm font-medium text-brown-soft transition hover:border-plum hover:text-plum"
						>
							Sign out
						</button>
					</div>
				</header>

				<p id="admin-load-error" class="mt-6 hidden rounded-2xl border border-mauve/30 bg-cream px-5 py-4 text-mauve-dark"></p>
				<p id="admin-loading" class="mt-8 text-brown-soft">Loading guests…</p>

				<!-- Summary cards -->
				<div id="admin-stats" class="mt-8 hidden grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-7">
					<div class="admin-stat-card">
						<p class="admin-stat-card__label">Total guests</p>
						<p class="admin-stat-card__value" data-stat="total">0</p>
					</div>
					<div class="admin-stat-card">
						<p class="admin-stat-card__label">Opened</p>
						<p class="admin-stat-card__value text-olive" data-stat="opened">0</p>
					</div>
					<div class="admin-stat-card">
						<p class="admin-stat-card__label">Not opened</p>
						<p class="admin-stat-card__value text-brown-soft" data-stat="notOpened">0</p>
					</div>
					<div class="admin-stat-card">
						<p class="admin-stat-card__label">RSVP yes</p>
						<p class="admin-stat-card__value text-olive" data-stat="rsvpAttending">0</p>
					</div>
					<div class="admin-stat-card">
						<p class="admin-stat-card__label">RSVP no</p>
						<p class="admin-stat-card__value text-mauve-dark" data-stat="rsvpDeclined">0</p>
					</div>
					<div class="admin-stat-card">
						<p class="admin-stat-card__label">Pending RSVP</p>
						<p class="admin-stat-card__value text-brown-muted" data-stat="rsvpPending">0</p>
					</div>
					<div class="admin-stat-card col-span-2 sm:col-span-1">
						<p class="admin-stat-card__label">Total attending</p>
						<p class="admin-stat-card__value text-plum" data-stat="totalAttending">0</p>
					</div>
				</div>

				<!-- Filters -->
				<div id="admin-filters" class="mt-8 hidden flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
					<div class="flex-1">
						<label for="admin-search" class="block text-sm font-medium text-plum">Search</label>
						<input
							type="search"
							id="admin-search"
							placeholder="Name, invite code, or message…"
							class="mt-2 w-full max-w-md rounded-xl border border-mauve/25 bg-white px-4 py-2.5 text-plum-deep outline-none ring-olive/40 focus:ring-2"
						/>
					</div>
					<div>
						<label for="admin-rsvp-filter" class="block text-sm font-medium text-plum">RSVP filter</label>
						<select
							id="admin-rsvp-filter"
							class="mt-2 w-full min-w-[10rem] rounded-xl border border-mauve/25 bg-white px-4 py-2.5 text-plum-deep outline-none ring-olive/40 focus:ring-2 lg:w-auto"
						>
							<option value="all">All</option>
							<option value="pending">Pending</option>
							<option value="attending">Attending</option>
							<option value="declined">Not attending</option>
						</select>
					</div>
				</div>

				<!-- Table -->
				<div id="admin-table-wrap" class="mt-6 hidden overflow-x-auto rounded-2xl border border-mauve/20 bg-cream shadow-sm">
					<table class="admin-table min-w-full text-left text-sm">
						<thead>
							<tr>
								<th>Guest</th>
								<th>Invite</th>
								<th>Opens</th>
								<th>RSVP</th>
								<th>Attending</th>
								<th>Details</th>
								<th>Submitted</th>
								<th>Manage</th>
							</tr>
						</thead>
						<tbody id="admin-table-body"></tbody>
					</table>
					<p id="admin-empty" class="hidden px-6 py-12 text-center text-brown-soft">
						No guests match your filters.
					</p>
				</div>
			</div>
		</div>
	</div>
</MainLayout>

<script define:vars={{ SITE_URL, SESSION_KEY }}>
	const loginEl = document.getElementById('admin-login');
	const dashboardEl = document.getElementById('admin-dashboard');
	const loginForm = document.getElementById('admin-login-form');
	const loginError = document.getElementById('admin-login-error');
	const signOutBtn = document.getElementById('admin-sign-out');
	const clearRsvpsBtn = document.getElementById('admin-clear-rsvps');
	const loadingEl = document.getElementById('admin-loading');
	const loadErrorEl = document.getElementById('admin-load-error');
	const statsEl = document.getElementById('admin-stats');
	const filtersEl = document.getElementById('admin-filters');
	const tableWrap = document.getElementById('admin-table-wrap');
	const tableBody = document.getElementById('admin-table-body');
	const emptyEl = document.getElementById('admin-empty');
	const searchInput = document.getElementById('admin-search');
	const rsvpFilter = document.getElementById('admin-rsvp-filter');
	const guestCountLabel = document.getElementById('guest-count-label');

	/** @type {Array<Record<string, unknown>>} */
	let allGuests = [];

	function getToken() {
		return sessionStorage.getItem(SESSION_KEY);
	}

	function setToken(token) {
		sessionStorage.setItem(SESSION_KEY, token);
	}

	function clearToken() {
		sessionStorage.removeItem(SESSION_KEY);
	}

	function showLogin() {
		loginEl?.classList.remove('hidden');
		dashboardEl?.classList.add('hidden');
	}

	function showDashboard() {
		loginEl?.classList.add('hidden');
		dashboardEl?.classList.remove('hidden');
	}

	function guestName(g) {
		return String(g.guest_name ?? g.invite_code ?? '—');
	}

	function rsvpStatus(g) {
		if (!g.rsvp_submitted) return 'pending';
		if (g.rsvp_attending === true) return 'attending';
		if (g.rsvp_attending === false) return 'declined';
		return 'pending';
	}

	function hasOpened(g) {
		return Boolean(g.invite_opened) || (g.open_count ?? 0) > 0;
	}

	function fmtDate(iso) {
		if (!iso) return '—';
		return new Intl.DateTimeFormat('en-US', {
			dateStyle: 'medium',
			timeStyle: 'short',
		}).format(new Date(iso));
	}

	function badge(text, variant) {
		return `<span class="admin-badge admin-badge--${variant}">${text}</span>`;
	}

	function rsvpBadge(g) {
		const s = rsvpStatus(g);
		if (s === 'attending') return badge('Attending', 'attending');
		if (s === 'declined') return badge('Not attending', 'declined');
		return badge('Pending', 'pending');
	}

	function updateStats(stats) {
		if (!stats) return;
		document.querySelectorAll('[data-stat]').forEach((el) => {
			const key = el.getAttribute('data-stat');
			if (key && key in stats) el.textContent = String(stats[key]);
		});
	}

	function getFilteredGuests() {
		const q = (searchInput?.value ?? '').trim().toLowerCase();
		const rsvp = rsvpFilter?.value ?? 'all';

		return allGuests.filter((g) => {
			const status = rsvpStatus(g);
			if (rsvp !== 'all' && status !== rsvp) return false;

			if (!q) return true;
			const haystack = [
				g.guest_name,
				g.invite_code,
				g.rsvp_guest_names,
				...(Array.isArray(g.rsvp_guest_names_list) ? g.rsvp_guest_names_list : []),
				g.rsvp_message,
			]
				.filter(Boolean)
				.join(' ')
				.toLowerCase();
			return haystack.includes(q);
		});
	}

	function sourceBadge(g) {
		if (g.rsvp_source === 'manual') return badge('Manual entry', 'muted');
		if (g.rsvp_submitted && g.rsvp_source === 'guest') return badge('Guest form', 'muted');
		return '';
	}

	function initialRsvpFormState(g) {
		const status = rsvpStatus(g);
		const maxGuests = Number(g.max_guests ?? 1);
		const names = Array.isArray(g.rsvp_guest_names_list) ? [...g.rsvp_guest_names_list] : [];
		let partySize = 1;

		if (status === 'attending') {
			partySize = Math.max(1, Number(g.rsvp_total_attending ?? names.length ?? 1));
			while (names.length < partySize) names.push('');
			if (names.length > partySize) names.length = partySize;
		}

		return {
			status,
			partySize,
			names,
			message: String(g.rsvp_message ?? ''),
			maxGuests,
		};
	}

	function renderGuestNameFields(names, maxGuests) {
		return names
			.map(
				(name, index) => `
					<div>
						<label class="admin-rsvp-form__label">Guest ${index + 1} name</label>
						<input
							type="text"
							class="admin-rsvp-name-input mt-1 w-full rounded-xl border border-mauve/25 bg-white px-3 py-2 text-sm text-plum-deep outline-none ring-olive/40 focus:ring-2"
							data-name-index="${index}"
							value="${escapeHtml(name)}"
							placeholder="Full name"
						/>
					</div>
				`
			)
			.join('');
	}

	function renderRsvpEditForm(g) {
		const code = String(g.invite_code ?? '');
		const state = initialRsvpFormState(g);
		const showPartyFields = state.status === 'attending';

		return `
			<form class="admin-rsvp-form space-y-4" data-invite-code="${escapeHtml(code)}">
				<div class="grid gap-4 md:grid-cols-2">
					<div>
						<label class="admin-rsvp-form__label">RSVP status</label>
						<select
							name="rsvpStatus"
							class="admin-rsvp-status mt-1 w-full rounded-xl border border-mauve/25 bg-white px-3 py-2 text-sm text-plum-deep outline-none ring-olive/40 focus:ring-2"
						>
							<option value="pending" ${state.status === 'pending' ? 'selected' : ''}>Not RSVP'd</option>
							<option value="attending" ${state.status === 'attending' ? 'selected' : ''}>Attending</option>
							<option value="declined" ${state.status === 'declined' ? 'selected' : ''}>Not attending</option>
						</select>
					</div>
					<div class="admin-rsvp-party-wrap ${showPartyFields ? '' : 'hidden'}">
						<label class="admin-rsvp-form__label">Party size</label>
						<input
							type="number"
							name="partySize"
							min="1"
							max="${state.maxGuests}"
							value="${state.partySize}"
							class="admin-rsvp-party-size mt-1 w-full rounded-xl border border-mauve/25 bg-white px-3 py-2 text-sm text-plum-deep outline-none ring-olive/40 focus:ring-2"
						/>
						<p class="mt-1 text-xs text-brown-muted">Max ${state.maxGuests} for this invitation</p>
					</div>
				</div>

				<div class="admin-rsvp-names-wrap ${showPartyFields ? '' : 'hidden'}">
					<p class="admin-rsvp-form__label">Attending guest names</p>
					<div class="admin-rsvp-names mt-2 grid gap-3 sm:grid-cols-2">
						${renderGuestNameFields(state.names, state.maxGuests)}
					</div>
				</div>

				<div>
					<label class="admin-rsvp-form__label">Message (optional)</label>
					<textarea
						name="message"
						rows="2"
						class="mt-1 w-full rounded-xl border border-mauve/25 bg-white px-3 py-2 text-sm text-plum-deep outline-none ring-olive/40 focus:ring-2"
						placeholder="Dietary needs, song requests, etc."
					>${escapeHtml(state.message)}</textarea>
				</div>

				<div class="flex flex-wrap items-center gap-3">
					<button
						type="submit"
						class="admin-rsvp-save rounded-full bg-plum px-5 py-2 text-sm font-medium text-cream transition hover:bg-mauve-dark"
					>
						Update RSVP
					</button>
					<p class="admin-rsvp-form-error hidden text-sm text-mauve-dark" role="alert"></p>
					<p class="admin-rsvp-form-success hidden text-sm text-olive" role="status"></p>
				</div>
			</form>
		`;
	}

	function bindRsvpForm(form, guest) {
		const statusSelect = form.querySelector('.admin-rsvp-status');
		const partyWrap = form.querySelector('.admin-rsvp-party-wrap');
		const namesWrap = form.querySelector('.admin-rsvp-names-wrap');
		const partySizeInput = form.querySelector('.admin-rsvp-party-size');
		const namesContainer = form.querySelector('.admin-rsvp-names');
		const maxGuests = Number(guest.max_guests ?? 1);

		function currentNames() {
			return [...form.querySelectorAll('.admin-rsvp-name-input')].map((input) => input.value);
		}

		function syncNameFields() {
			if (!namesContainer || !partySizeInput) return;
			const count = Math.max(1, Math.min(maxGuests, Number(partySizeInput.value) || 1));
			partySizeInput.value = String(count);
			const existing = currentNames();
			const next = Array.from({ length: count }, (_, index) => existing[index] ?? '');
			namesContainer.innerHTML = renderGuestNameFields(next, maxGuests);
		}

		function syncVisibility() {
			const attending = statusSelect?.value === 'attending';
			partyWrap?.classList.toggle('hidden', !attending);
			namesWrap?.classList.toggle('hidden', !attending);
			if (attending) syncNameFields();
		}

		statusSelect?.addEventListener('change', syncVisibility);
		partySizeInput?.addEventListener('change', syncNameFields);
		partySizeInput?.addEventListener('input', syncNameFields);

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const token = getToken();
			if (!token) {
				showLogin();
				return;
			}

			const errorEl = form.querySelector('.admin-rsvp-form-error');
			const successEl = form.querySelector('.admin-rsvp-form-success');
			const saveBtn = form.querySelector('.admin-rsvp-save');
			errorEl?.classList.add('hidden');
			successEl?.classList.add('hidden');

			const inviteCode = form.getAttribute('data-invite-code');
			const rsvpStatus = statusSelect?.value ?? 'pending';
			const partySize = Number(partySizeInput?.value ?? 0);
			const guestNames =
				rsvpStatus === 'attending' ?
					[...form.querySelectorAll('.admin-rsvp-name-input')].map((input) => input.value.trim())
				:	[];
			const message = String(form.querySelector('[name="message"]')?.value ?? '').trim();

			const originalLabel = saveBtn?.textContent ?? 'Update RSVP';
			saveBtn?.setAttribute('disabled', 'true');
			if (saveBtn) saveBtn.textContent = 'Saving…';

			try {
				const res = await fetch('/api/admin/rsvps', {
					method: 'PUT',
					headers: {
						Authorization: `Bearer ${token}`,
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({
						invite_code: inviteCode,
						rsvpStatus,
						totalGuests: rsvpStatus === 'attending' ? partySize : 0,
						guestNames,
						message,
					}),
				});
				const data = await res.json();

				if (res.status === 401) {
					clearToken();
					showLogin();
					return;
				}

				if (!res.ok || !data.ok) {
					throw new Error(data.error ?? 'Failed to save RSVP');
				}

				const updated = data.guest;
				const index = allGuests.findIndex(
					(row) => String(row.invite_code) === String(updated.invite_code)
				);
				if (index >= 0) {
					allGuests[index] = { ...allGuests[index], ...updated };
				}

				updateStats(computeStatsFromGuests(allGuests));
				renderTable();

				if (successEl) {
					successEl.textContent = 'RSVP updated.';
					successEl.classList.remove('hidden');
				}
			} catch (err) {
				if (errorEl) {
					errorEl.textContent = err instanceof Error ? err.message : 'Could not save RSVP.';
					errorEl.classList.remove('hidden');
				}
			} finally {
				saveBtn?.removeAttribute('disabled');
				if (saveBtn) saveBtn.textContent = originalLabel;
			}
		});
	}

	function renderTable() {
		const guests = getFilteredGuests();
		if (!tableBody) return;

		if (guestCountLabel) {
			guestCountLabel.textContent = String(allGuests.length);
		}

		if (guests.length === 0) {
			tableBody.innerHTML = '';
			emptyEl?.classList.remove('hidden');
			return;
		}

		emptyEl?.classList.add('hidden');

		tableBody.innerHTML = guests
			.map((g) => {
				const code = String(g.invite_code ?? '');
				const inviteUrl = `${SITE_URL}/?invite_code=${encodeURIComponent(code)}`;
				const status = rsvpStatus(g);
				const attending =
					status === 'attending' ?
						String(g.rsvp_total_attending ?? '—')
					: status === 'declined' ? '0'
					: '—';
				const editId = `rsvp-edit-${code}`;

				return `<tr class="guest-summary-row">
					<td data-label="Guest">
						<p class="font-medium text-plum">${escapeHtml(guestName(g))}</p>
						<p class="mt-0.5 text-xs text-brown-muted">Max guests: ${g.max_guests ?? '—'}</p>
					</td>
					<td data-label="Invite">
						<p class="font-mono text-xs text-plum">${escapeHtml(g.invite_code)}</p>
						<button type="button" class="admin-copy mt-2" data-url="${escapeHtml(inviteUrl)}">Copy link</button>
					</td>
					<td data-label="Opens">
						<p class="text-sm text-plum">Opened: ${hasOpened(g) ? 'Yes' : 'No'}</p>
						<p class="mt-1 text-xs text-brown-soft">Open count: ${g.open_count ?? 0}</p>
						<p class="text-xs text-brown-muted">First opened: ${fmtDate(g.first_opened_at)}</p>
						<p class="text-xs text-brown-muted">Last opened: ${fmtDate(g.last_opened_at)}</p>
					</td>
					<td data-label="RSVP">
						${rsvpBadge(g)}
						${sourceBadge(g) ? `<div class="mt-1">${sourceBadge(g)}</div>` : ''}
					</td>
					<td data-label="Attending" class="font-medium">${attending}</td>
					<td data-label="Details">
						<p class="text-xs font-medium text-brown-muted">Attending names</p>
						${guestNamesDisplay(g)}
						<p class="mt-2 text-xs font-medium text-brown-muted">Message</p>
						<p class="text-xs text-brown-muted max-w-[14rem]" title="${escapeHtml(g.rsvp_message ?? '')}">${escapeHtml(g.rsvp_message ?? '—')}</p>
					</td>
					<td data-label="Submitted">
						<p class="text-xs whitespace-nowrap">${fmtDate(g.rsvp_submitted_at)}</p>
					</td>
					<td data-label="Manage">
						<button
							type="button"
							class="admin-edit-rsvp rounded-full border border-mauve/25 bg-white px-4 py-2 text-xs font-medium text-plum transition hover:border-plum hover:bg-ivory"
							data-edit-target="${escapeHtml(editId)}"
							aria-expanded="false"
						>
							Edit RSVP
						</button>
					</td>
				</tr>
				<tr id="${escapeHtml(editId)}" class="guest-rsvp-edit hidden">
					<td colspan="8" class="!p-0">
						<div class="border-t border-mauve/15 bg-ivory/60 px-4 py-5 md:px-6">
							<p class="mb-4 text-sm font-medium text-plum">Manual RSVP for ${escapeHtml(guestName(g))}</p>
							${renderRsvpEditForm(g)}
						</div>
					</td>
				</tr>`;
			})
			.join('');

		tableBody.querySelectorAll('.admin-copy').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const url = btn.getAttribute('data-url');
				if (!url) return;
				try {
					await navigator.clipboard.writeText(url);
					btn.textContent = 'Copied!';
					setTimeout(() => {
						btn.textContent = 'Copy link';
					}, 2000);
				} catch {
					btn.textContent = 'Copy failed';
				}
			});
		});

		tableBody.querySelectorAll('.admin-edit-rsvp').forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-edit-target');
				const panel = targetId ? document.getElementById(targetId) : null;
				if (!panel) return;

				const isHidden = panel.classList.contains('hidden');
				tableBody.querySelectorAll('.guest-rsvp-edit').forEach((row) => row.classList.add('hidden'));
				tableBody.querySelectorAll('.admin-edit-rsvp').forEach((toggle) => {
					toggle.setAttribute('aria-expanded', 'false');
					toggle.textContent = 'Edit RSVP';
				});

				if (isHidden) {
					panel.classList.remove('hidden');
					btn.setAttribute('aria-expanded', 'true');
					btn.textContent = 'Close';
					const form = panel.querySelector('.admin-rsvp-form');
					if (form && !form.dataset.bound) {
						const inviteCode = form.getAttribute('data-invite-code');
						const guest = allGuests.find((row) => String(row.invite_code) === inviteCode);
						if (guest) bindRsvpForm(form, guest);
						form.dataset.bound = 'true';
					}
				}
			});
		});
	}

	function escapeHtml(str) {
		return String(str ?? '')
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
	}

	function guestNamesDisplay(g) {
		const list = Array.isArray(g.rsvp_guest_names_list) ? g.rsvp_guest_names_list : [];
		if (list.length > 0) {
			return `<ul class="mt-1 space-y-0.5 text-xs text-brown-soft">${list
				.map((n) => `<li>${escapeHtml(n)}</li>`)
				.join('')}</ul>`;
		}
		const fallback = String(g.rsvp_guest_names ?? '').trim();
		return fallback ?
				`<p class="text-xs text-brown-soft">${escapeHtml(fallback)}</p>`
			:	'<p class="text-xs text-brown-soft">—</p>';
	}

	function computeStatsFromGuests(guests) {
		return guests.reduce(
			(acc, g) => {
				acc.total += 1;
				if (hasOpened(g)) acc.opened += 1;
				else acc.notOpened += 1;

				const status = rsvpStatus(g);
				if (status === 'pending') acc.rsvpPending += 1;
				else if (status === 'attending') {
					acc.rsvpAttending += 1;
					acc.totalAttending += g.rsvp_total_attending ?? 0;
				} else {
					acc.rsvpDeclined += 1;
				}

				return acc;
			},
			{
				total: 0,
				opened: 0,
				notOpened: 0,
				rsvpAttending: 0,
				rsvpDeclined: 0,
				rsvpPending: 0,
				totalAttending: 0,
			},
		);
	}

	function mergeInviteOpens(guests, records) {
		const openBySlug = new Map(
			(records ?? []).map((record) => [String(record.slug ?? '').toLowerCase(), record]),
		);

		return guests.map((guest) => {
			const open = openBySlug.get(String(guest.invite_code ?? '').toLowerCase());
			if (!open) {
				return {
					...guest,
					invite_opened: false,
					first_opened_at: null,
					last_opened_at: null,
					open_count: 0,
				};
			}

			return {
				...guest,
				invite_opened: Boolean(open.opened) || (open.openCount ?? 0) > 0,
				first_opened_at: open.firstOpenedAt ?? null,
				last_opened_at: open.lastOpenedAt ?? null,
				open_count: open.openCount ?? 0,
			};
		});
	}

	async function loadGuests() {
		const token = getToken();
		if (!token) {
			showLogin();
			return;
		}

		showDashboard();
		loadingEl?.classList.remove('hidden');
		loadErrorEl?.classList.add('hidden');

		try {
			const authHeaders = { Authorization: `Bearer ${token}` };
			const [guestsRes, opensRes] = await Promise.all([
				fetch('/api/admin/guests', { headers: authHeaders }),
				fetch('/.netlify/functions/get-invite-opens', { headers: authHeaders }),
			]);
			const data = await guestsRes.json();

			if (guestsRes.status === 401) {
				clearToken();
				showLogin();
				return;
			}

			if (!guestsRes.ok || !data.ok) {
				throw new Error(data.error ?? 'Failed to load guests');
			}

			let guests = data.guests ?? [];

			if (opensRes.ok) {
				const opensData = await opensRes.json();
				if (opensData.ok) {
					guests = mergeInviteOpens(guests, opensData.records ?? []);
				}
			}

			allGuests = guests;
			updateStats(computeStatsFromGuests(allGuests));
			loadingEl?.classList.add('hidden');
			statsEl?.classList.remove('hidden');
			filtersEl?.classList.remove('hidden');
			tableWrap?.classList.remove('hidden');
			renderTable();
		} catch (err) {
			loadingEl?.classList.add('hidden');
			if (loadErrorEl) {
				loadErrorEl.textContent =
					err instanceof Error ? err.message : 'Could not load guest data.';
				loadErrorEl.classList.remove('hidden');
			}
		}
	}

	loginForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		loginError?.classList.add('hidden');
		const password = new FormData(loginForm).get('password');

		try {
			const res = await fetch('/api/admin/verify', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ password }),
			});
			const data = await res.json();

			if (!res.ok || !data.ok) {
				if (loginError) {
					loginError.textContent = data.error ?? 'Incorrect password';
					loginError.classList.remove('hidden');
				}
				return;
			}

			setToken(data.token);
			loginForm.reset();
			await loadGuests();
		} catch {
			if (loginError) {
				loginError.textContent = 'Network error. Please try again.';
				loginError.classList.remove('hidden');
			}
		}
	});

	signOutBtn?.addEventListener('click', () => {
		clearToken();
		allGuests = [];
		showLogin();
	});

	clearRsvpsBtn?.addEventListener('click', async () => {
		const token = getToken();
		if (!token) {
			showLogin();
			return;
		}

		const confirmed = window.confirm(
			'Delete ALL submitted RSVPs from the form? This clears test responses and cannot be undone.'
		);
		if (!confirmed) return;

		const original = clearRsvpsBtn.textContent;
		clearRsvpsBtn.setAttribute('disabled', 'true');
		clearRsvpsBtn.textContent = 'Clearing…';

		try {
			const res = await fetch('/api/admin/rsvps', {
				method: 'DELETE',
				headers: { Authorization: `Bearer ${token}` },
			});
			const data = await res.json();

			if (res.status === 401) {
				clearToken();
				showLogin();
				return;
			}

			if (!res.ok || !data.ok) {
				throw new Error(data.error ?? 'Failed to clear RSVPs');
			}

			window.alert(`Cleared ${data.removed} RSVP${data.removed === 1 ? '' : 's'}.`);
			await loadGuests();
		} catch (err) {
			window.alert(err instanceof Error ? err.message : 'Could not clear RSVPs.');
		} finally {
			clearRsvpsBtn.removeAttribute('disabled');
			clearRsvpsBtn.textContent = original;
		}
	});

	searchInput?.addEventListener('input', renderTable);
	rsvpFilter?.addEventListener('change', renderTable);

	if (getToken()) {
		loadGuests();
	} else {
		showLogin();
	}
</script>

