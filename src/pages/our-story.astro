---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import EngagementVideo from '../components/EngagementVideo.astro';
import { storyIntro } from '../lib/our-story';
---

<MainLayout title="Our Story — Jocelyn & René">
	<Navbar />
	<main class="bg-ivory">
		<div class="border-b border-mauve/15 bg-cream py-12 md:py-16" data-reveal>
			<div class="mx-auto max-w-3xl px-6 text-center md:px-8">
				<h1 class="font-serif text-4xl text-plum md:text-5xl">
					<span data-strand="en">Our story</span>
					<span data-strand="es">Nuestra historia</span>
				</h1>
				<div class="mx-auto mt-4 h-px w-24 bg-mauve/60" aria-hidden="true"></div>
				<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brown-soft md:text-xl">
					<span data-strand="en">{storyIntro.en}</span>
					<span data-strand="es">{storyIntro.es}</span>
				</p>
			</div>
		</div>

		<StoryTimeline />
		<EngagementVideo />
	</main>
	<Footer />
</MainLayout>
