---
import MainLayout from '../layouts/MainLayout.astro';
import { getState } from '../lib/wedding-store';

export const prerender = true;

const expected = import.meta.env.ADMIN_SECRET ?? 'dev-admin-secret';
const secret = Astro.url.searchParams.get('secret') ?? '';
const authorized = secret === expected;

let rows: {
	slug: string;
	displayName: string;
	visitCount: number;
	lastVisit: string | null;
	rsvp: import('../lib/wedding-store').Rsvp | null;
}[] = [];

let recentVisits: import('../lib/wedding-store').Visit[] = [];

if (authorized) {
	const state = await getState();
	const visitsBySlug = new Map<string, { count: number; last: string }>();
	for (const v of state.visits) {
		const cur = visitsBySlug.get(v.slug) ?? { count: 0, last: v.at };
		const last = v.at > cur.last ? v.at : cur.last;
		visitsBySlug.set(v.slug, { count: cur.count + 1, last });
	}
	rows = state.guests.map((g) => {
		const v = visitsBySlug.get(g.slug);
		const rsvp = state.rsvps.find((r) => r.slug === g.slug) ?? null;
		return {
			slug: g.slug,
			displayName: g.displayName,
			visitCount: v?.count ?? 0,
			lastVisit: v?.last ?? null,
			rsvp,
		};
	});
	recentVisits = state.visits.slice().reverse().slice(0, 25);
}
---

<MainLayout title="Guest admin — Jordan & Riley" description="Internal guest visit and RSVP overview.">
	{
		!authorized ? (
			<div class="flex min-h-screen flex-col items-center justify-center bg-plum-deep px-6 py-20 text-center text-cream">
				<h1 class="font-serif text-3xl">Admin access</h1>
				<p class="mt-4 max-w-md text-ivory/80">
					Add <code class="rounded bg-white/10 px-2 py-0.5 text-sm">?secret=…</code> to the URL. Set{' '}
					<code class="rounded bg-white/10 px-1.5 py-0.5 text-sm">ADMIN_SECRET</code> in your environment;
					if unset, the development default is <code class="rounded bg-white/10 px-1.5 py-0.5 text-sm">dev-admin-secret</code>.
				</p>
			</div>
		) : (
			<div class="min-h-screen bg-ivory pb-20 pt-12">
				<div class="mx-auto max-w-5xl px-6 md:px-8">
					<h1 class="font-serif text-4xl text-plum">Guest visits & RSVPs</h1>
					<p class="mt-2 text-brown-soft">
						Placeholder admin view. Data is stored in <code class="text-sm text-plum">data/wedding-state.json</code>.
					</p>
					<div class="mt-10 overflow-x-auto rounded-2xl border border-mauve/20 bg-cream shadow-sm">
						<table class="min-w-full text-left text-sm">
							<thead class="border-b border-mauve/20 bg-white/80 text-xs font-semibold uppercase tracking-wider text-olive">
								<tr>
									<th class="px-4 py-3">Guest</th>
									<th class="px-4 py-3">Slug</th>
									<th class="px-4 py-3">Visits</th>
									<th class="px-4 py-3">Last visit</th>
									<th class="px-4 py-3">RSVP</th>
									<th class="px-4 py-3">Party</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-mauve/15 text-brown-soft">
								{rows.map((r) => (
									<tr class="bg-white/40 hover:bg-white/70">
										<td class="px-4 py-3 font-medium text-plum">{r.displayName}</td>
										<td class="px-4 py-3 font-mono text-xs">{r.slug}</td>
										<td class="px-4 py-3">{r.visitCount}</td>
										<td class="px-4 py-3 text-xs">
											{r.lastVisit ? new Date(r.lastVisit).toLocaleString() : '—'}
										</td>
										<td class="px-4 py-3">
											{r.rsvp ? (
												<span class={r.rsvp.attending ? 'text-olive' : 'text-mauve-dark'}>
													{r.rsvp.attending ? 'Attending' : 'Declined'}
												</span>
											) : (
												<span class="text-brown-muted">Pending</span>
											)}
										</td>
										<td class="px-4 py-3">{r.rsvp?.guestCount ?? '—'}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<section class="mt-12">
						<h2 class="font-serif text-2xl text-plum">Recent visits (log)</h2>
						<ul class="mt-4 space-y-2 text-sm text-brown-soft">
							{recentVisits.map((v) => (
									<li class="rounded-xl border border-mauve/15 bg-white/60 px-4 py-3 font-mono text-xs md:text-sm">
										<span class="text-plum">{v.slug}</span> · {new Date(v.at).toLocaleString()} ·{' '}
										<span class="text-brown-muted">{v.userAgent ?? 'unknown client'}</span>
									</li>
								))}
						</ul>
					</section>
				</div>
			</div>
		)
	}
</MainLayout>
