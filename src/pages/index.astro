---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WeddingSiteContent from '../components/WeddingSiteContent.astro';
import { readInviteCodeFromSearchParams } from '../lib/invite-link';

const inviteCode = readInviteCodeFromSearchParams(Astro.url.searchParams);
---

<MainLayout showInvitationIntro>
	<Navbar integrated inviteCode={inviteCode} />
	<main>
		<WeddingSiteContent inviteCode={inviteCode} />
	</main>
	<Footer />
</MainLayout>
