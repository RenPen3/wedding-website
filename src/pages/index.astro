---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import WeddingDetails from '../components/WeddingDetails.astro';
import Schedule from '../components/Schedule.astro';
import RSVPForm from '../components/RSVPForm.astro';
import Registry from '../components/Registry.astro';
import TravelInfo from '../components/TravelInfo.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { getState } from '../lib/wedding-store';

const { guests, rsvps } = await getState();
---

<MainLayout>
	<Navbar integrated />
	<main>
		<Hero />
		<Countdown />
		<WeddingDetails />
		<Schedule />
		<section id="rsvp" class="scroll-mt-24 bg-plum-deep py-20 text-cream md:py-28" data-reveal>
			<div class="mx-auto max-w-xl px-6 md:px-8">
				<h2 class="text-center font-serif text-3xl md:text-4xl">
					<span data-strand="en">Kindly respond</span>
					<span data-strand="es">Confirma tu asistencia</span>
				</h2>
				<p class="mx-auto mt-3 max-w-md text-center text-ivory/80">
					<span data-strand="en">We cannot wait to celebrate with you. Please submit one RSVP per invitation.</span>
					<span data-strand="es">
						No vemos la hora de celebrar contigo. Por favor envía una confirmación por invitación.</span>
				</p>
				<div class="mt-10">
					<RSVPForm guests={guests} rsvps={rsvps} />
				</div>
			</div>
		</section>
		<Registry />
		<TravelInfo />
		<FAQ />
	</main>
	<Footer />
</MainLayout>
